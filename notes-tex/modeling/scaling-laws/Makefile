# notes-tex/modeling/scaling-laws/Makefile
# [[scaling-laws]]
# https://github.com/Mjvolk3/torchcell/tree/main/notes-tex/modeling/scaling-laws/Makefile
#
# The scaling-laws explainer: the Kaplan and Chinchilla forms, how to count N, D and
# C for genotype-to-phenotype data, and the minimal ablation that gives a defensible
# curve. No Zotero collection yet: the works it draws on (Kaplan 2020, Hoffmann 2022,
# Besiroglu 2024, Yang 2022, Muennighoff 2023) are not in the mirror and are named by
# arXiv id in prose, flagged \external. When a collection exists, set
# ZOTERO_PERSONAL_COLLECTION, run `python scripts/lit_bib_store.py --name
# scaling-laws`, then `make bib-pull`.
#
# The one figure and the constants table are written by
# experiments/041-scaling-laws/scripts/scaling_law_forms.py; `make plots` converts the
# panel from $ASSET_IMAGES_DIR/041-scaling-laws/. The GIFs that script also writes are
# for the Dendron note, not for this PDF.

PLOT_SLUGS := 041-scaling-laws

include ../../common/Makefile.common
