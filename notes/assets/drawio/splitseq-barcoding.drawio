        <mxCell id="s4dt" value="dT15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="376" y="389" width="38" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s4cdna" value="cDNA (first strand)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="414" y="389" width="150" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s4e3" value="3&#8242;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="566" y="389" width="16" height="22"  as="geometry" />
        </mxCell>

        <mxCell id="a45" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#666666;endSize=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="131" y="415" as="sourcePoint" />
            <mxPoint x="131" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n45" value="&lt;b&gt;No sequence change &#8211; this is a selection.&lt;/b&gt; Split into sublibraries of 5,000-20,000 cells, then lyse (SDS plus proteinase K, 55 &#176;C, 2 h); streptavidin beads keep only molecules that received the round-3 oligo, so anything outside the barcoding scheme is never sequenced." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="154" y="415" width="548" height="24"  as="geometry" />
        </mxCell>

        <!-- ============================ STEP 5 ============================ -->
