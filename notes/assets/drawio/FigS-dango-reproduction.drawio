t="24.3" as="geometry"/></mxCell><mxCell id="8" value="$$\textstyle H^{(k)}=F^{(k)}(\mathbf{E},A^{(k)}),\quad \mathbf{E}\in\mathbb{R}^{N\times d}$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="67.3" width="196.0" height="13.3" as="geometry"/></mxCell><mxCell id="9" value="Reconstruction head" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacing=0;spacingLeft=5;spacingRight=5;spacingTop=-1;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="564.5" y="56.3" width="140.5" height="24.3" as="geometry"/></mxCell><mxCell id="10" value="$$\textstyle \hat A^{(k)}=H^{(k)}W_k,\quad \mathcal{L}_{\mathrm{rec}}(\lambda_k)$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="564.5" y="67.3" width="140.5" height="13.3" as="geometry"/></mxCell><mxCell id="11" value="Meta-embedding merges the six channels" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacing=0;spacingLeft=5;spacingRight=5;spacingTop=-1;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="358.5" y="90.6" width="346.5" height="24.3" as="geometry"/></mxCell><mxCell id="12" value="$$\textstyle h_i=\sum\nolimits_k a_{ik}\,h_i^{(k)},\quad a_{i:}=\operatorname{softmax}_k\,\mathrm{MLP}(h_i^{(k)}),\quad H=(h_1,\dots,h_N)$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="101.6" width="346.5" height="13.3" as="geometry"/></mxCell><mxCell id="13" value="Perturbation selects rows; no perturbation operator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacing=0;spacingLeft=5;spacingRight=5;spacingTop=-1;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="358.5" y="124.9" width="346.5" height="24.3" as="geometry"/></mxCell><mxCell id="14" value="$$\textstyle p=\{g_i,g_j,g_k\}\ \mapsto\ (h_i,h_j,h_k),\quad H\ \text{unchanged}$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="135.9" width="346.5" height="13.3" as="geometry"/></mxCell><mxCell id="15" value="Hyper-SAGNN readout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacing=0;spacingLeft=5;spacingRight=5;spacingTop=-1;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="358.5" y="159.1" width="176.0" height="24.3" as="geometry"/></mxCell><mxCell id="16" value="$$\textstyle \hat y_{\mathrm{int}}=|p|^{-1}\sum\nolimits_{t\in p}\mathrm{FC}\big((d_t-s_t)^{2}\big)$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="170.1" width="176.0" height="13.3" as="geometry"/></mxCell><mxCell id="17" value="Interaction loss" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacing=0;spacingLeft=5;spacingRight=5;spacingTop=-1;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="544.5" y="159.1" width="160.5" height="24.3" as="geometry"/></mxCell><mxCell id="18" value="$$\textstyle \mathcal{L}_{\mathrm{int}}=\operatorname{mean}\log\cosh(\hat y_{\mathrm{int}}-y_{\mathrm{int}})$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="544.5" y="170.1" width="160.5" height="13.3" as="geometry"/></mxCell><mxCell id="19" value="Objective; the pretraining weight follows one of three schedules over epochs 1 to 10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacing=0;spacingLeft=5;spacingRight=5;spacingTop=-1;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="358.5" y="193.4" width="346.5" height="24.3" as="geometry"/></mxCell><mxCell id="20" value="$$\textstyle \mathcal{L}=\alpha_e\,\mathcal{L}_{\mathrm{rec}}+(1-\alpha_e)\,\mathcal{L}_{\mathrm{int}}$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="204.4" width="346.5" height="13.3" as="geometry"/></mxCell><mxCell id="21" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="456.5" y="46.3" as="sourcePoint"/><mxPoint x="456.5" y="56.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="554.5" y="68.4" as="sourcePoint"/><mxPoint x="564.5" y="68.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="456.5" y="80.6" as="sourcePoint"/><mxPoint x="456.5" y="90.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" style="endArrow=classic;html=1;strokeWidth=