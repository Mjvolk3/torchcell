<mxfile><diagram id="module-lp" name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="717" pageHeight="221" math="1" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="11" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;gene tokens&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;h&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; from the backbone, perturbed graph" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0.00" y="0.00" width="78.00" height="80.00" as="geometry"/></mxCell><mxCell id="12" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;abundance head&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;&amp;gamma;&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;E&lt;/i&gt;&lt;sup&gt;0&lt;/sup&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; exp(&lt;i&gt;r&lt;/i&gt; tanh(&lt;i&gt;w&lt;/i&gt;&amp;middot;&lt;i&gt;h&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt;)); &lt;i&gt;&amp;gamma;&lt;/i&gt; hard (1 present, 0 deleted), no learned gate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="91.00" y="0.00" width="106.00" height="80.00" as="geometry"/></mxCell><mxCell id="13" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;unit abundance&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt;: power mean over a complex's subunits, sum over isozymes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="210.00" y="0.00" width="86.00" height="80.00" as="geometry"/></mxCell><mxCell id="14" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;box&lt;/b&gt;&lt;/span&gt;&lt;br&gt;|&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;| &amp;le; &lt;i&gt;k&lt;/i&gt;&lt;sub&gt;cat,&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt; &amp;times; scale, inside [&lt;i&gt;lb&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;, &lt;i&gt;ub&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;] scaled by availability" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="309.00" y="0.00" width="104.00" height="80.00" as="geometry"/></mxCell><mxCell id="15" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;growth LP&lt;/b&gt;&lt;/span&gt;&lt;br&gt;max {&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;growth&lt;/sub&gt; : &lt;i&gt;S&lt;/i&gt;&lt;i&gt;v&lt;/i&gt; = 0, &lt;i&gt;lb&lt;/i&gt; &amp;le; &lt;i&gt;v&lt;/i&gt; &amp;le; &lt;i&gt;ub&lt;/i&gt;}, HiGHS per genotype in a forked pool" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="426.00" y="0.00" width="100.00" height="80.00" as="geometry"/></mxCell><mxCell id="16" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;optimum&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;v&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt;, &lt;i&gt;z&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="539.00" y="0.00" width="112.00" height="80.00" as="geometry"/></mxCell><mxCell id="17" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;readout&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;a&lt;/i&gt; &lt;i&gt;z&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt; + &lt;i&gt;b&lt;/i&gt;, or gated: head(&lt;i&gt;z&lt;/i&gt;) + &lt;i&gt;g&lt;/i&gt; (&lt;i&gt;a&lt;/i&gt; &lt;i&gt;z&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt; + &lt;i&gt;b&lt;/i&gt;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="664.00" y="0.00" width="53.00" height="80.00" as="geometry"/></mxCell><mxCell id="18" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="19" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="15" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="476.00" y="106.00"/><mxPoint x="144.00" y="106.00"/></Array></mxGeometry></mxCell><mxCell id="25" value="backward: &amp;part;&lt;i&gt;z&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt;/&amp;part;&lt;i&gt;ub&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt; is the dual of the ceiling (envelope theorem), nonzero only where the bound binds; through &lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; to the backbone" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="154.00" y="110.00" width="312.00" height="24.00" as="geometry"/></mxCell><mxCell id="26" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;by construction&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;S&lt;/i&gt;&lt;i&gt;v&lt;/i&gt; = 0 and &lt;i&gt;lb&lt;/i&gt; &amp;le; &lt;i&gt;v&lt;/i&gt; &amp;le; &lt;i&gt;ub&lt;/i&gt; hold exactly at &lt;i&gt;v&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt;, the ceilings with them&lt;br&gt;&lt;i&gt;v&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt; is piecewise constant in the bounds and carries no gradient; only &lt;i&gt;z&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt; does&lt;br&gt;the forced flux of the maintenance reaction (lb 0.7 mmol/gDW/h) must be carried inside the ceilings" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=left;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0.00" y="146.00" width="440.00" height="74.00" as="geometry"/></mxCell><mxCell id="27" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;measured (rounds 15 to 15d)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;an infeasible program returns the zero flux and no gradient, so the state is absorbing (rounds 15b to 15d); duals on exchange bounds belong to no gene, so with no ceiling binding the backbone receives nothing (round 15b)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.8;align=left;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="456.00" y="146.00" width="261.00" height="74.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>