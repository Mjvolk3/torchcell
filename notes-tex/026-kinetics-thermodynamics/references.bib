  pages = {3607},
  publisher = {Nature Publishing Group},
  shorttitle = {{scPRINT}},
  title = {{scPRINT}: pre-training on 50 million cells allows robust gene network predictions},
  url = {https://www.nature.com/articles/s41467-025-58699-1},
  urldate = {2025-06-10},
