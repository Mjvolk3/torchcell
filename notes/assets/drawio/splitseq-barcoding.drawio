          <mxGeometry x="154" y="389" width="66" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s4umi" value="UMI&#10;10 nt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="220" y="389" width="42" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s4bc3" value="BC3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
