/* torchcell Neo4j Browser stylesheet. Generated by
 * python -m torchcell.database.browser_style; do not edit by hand.
 * Ancestor labels first so the class rules below win on multi-label nodes;
 * class colors are the ontology lanes of the paper figures. */

node {
  color: #F5F5F5;
  border-color: #666666;
  border-width: 2px;
  text-color-internal: #000000;
  diameter: 50px;
  font-size: 10px;
}

relationship {
  color: #666666;
  shaft-width: 1px;
  font-size: 8px;
  padding: 3px;
  text-color-external: #000000;
  text-color-internal: #FFFFFF;
  caption: "<type>";
}

