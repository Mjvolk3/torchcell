# notes-tex/database/044-organism-similarity/Makefile
# [[experiments.044-organism-similarity]]
# https://github.com/Mjvolk3/torchcell/tree/main/notes-tex/database/044-organism-similarity/Makefile
#
# No ZOTERO_COLLECTION: the few sources the document names (Peter et al. 2018, Peris et
# al. 2023, the 1000 Genomes Project 2015) are carried in prose with their pins recorded
# in the experiment's result files, not as \cite keys, so there is no collection to export
# and `make bib` is not meant to run here. references.bib is an empty placeholder because
# the shared build rules list it as a prerequisite. Same arrangement as
# notes-tex/database/database-expansion-100.
#
# Regenerate, in order, from the repo root (env sourced, PYTHONPATH=.):
#   python experiments/044-organism-similarity/scripts/07_figures.py
#   python experiments/044-organism-similarity/scripts/08_notes_tex_numbers.py
# then here: `make plots` (SVG -> figures/*.pdf at true size, Makefile.common), `make`.
# numbers.tex, figures.tex and tables/*.tex are generated by 08; never hand-edit them.
# PLOT_SLUG defaults to this directory's name, which is the ASSET_IMAGES_DIR folder the
# figures are written to.

PYTHON ?= /home/michaelvolk/miniconda3/envs/torchcell/bin/python

include ../../common/Makefile.common

# numbers.tex and figures.tex are \input by the root but are not under sections/ or
# tables/: they join DEPS (which `make plots` greps for figures/NAME.pdf, and figures.tex
# is where the timestamped names live) and the PDF's prerequisites.
DEPS += numbers.tex figures.tex
$(DOC).pdf: numbers.tex figures.tex
