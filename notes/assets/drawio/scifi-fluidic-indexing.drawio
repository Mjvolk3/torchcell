<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram name="scifi-fluidic-indexing" id="scifiFluidicIndexing">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="703" pageHeight="510" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================================================================
             TRUE-SIZE CANVAS. 100 draw.io units = 1 inch. 0..698 x 0..~490.
             Arial; 8.5 units = 6.1 pt (Nature 6 pt min); title 12.
             Palette = PLOT_PALETTE / PLOT_PALETTE_FILL slots 1..6; segment
             colors match Figs. 1..3: orange transcript/cDNA, red round1
             barcode, purple round2 / gel bead, blue UMI, yellow droplet/oil,
             gray handle/adapter.
             En dashes are the real character (&#8211;), never a double hyphen:
             a canvas does not typeset "&#45;&#45;" the way LaTeX does.
             Every drawn number has a record in
             experiments/024-perturb-seq-costing/scripts/figure_sources.py
             Panel c column grid:
               round2 150..212 | PBS 212..272 | round1 272..322 | UMI 322..366
               dT 366..400 | cDNA 400..556 | i7+library 556..624
             ================================================================ -->

        <mxCell id="title" value="scifi-RNA-seq: pre-index the cells and droplet overloading stops being a failure mode" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="698" height="15" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Combinatorial fluidic indexing of Datlinger et al. 2021. Poisson loading limits a droplet run only while each droplet must hold exactly one cell. Barcoding the cells first removes that requirement, so the same Chromium channel can be loaded a hundredfold harder. Colors and the 5&#8242;-to-3&#8242; convention follow Figs. 2 and 3." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="17" width="698" height="24" as="geometry" />
        </mxCell>

        <!-- ============================= PANEL a ============================= -->
        <mxCell id="pa" value="a" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="48" width="10" height="12" as="geometry" />
        </mxCell>
        <mxCell id="pah" value="What overloading a Chromium channel actually does, counted under a microscope" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="13" y="48" width="520" height="12" as="geometry" />
        </mxCell>
        <mxCell id="paNote" value="Both regimes ran without clogging the device. The droplets are drawn schematically; the counts are the measured means. In the separate yield run, 383,000 loaded nuclei returned 151,788 transcriptomes from one channel." style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="62" width="112" height="76" as="geometry" />
        </mxCell>

        <mxCell id="r1h" value="maximum recommended load &#8211; 15,300 nuclei per channel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="118" y="68" width="284" height="14" as="geometry" />
        </mxCell>
        <mxCell id="r2h" value="100&#215; overloaded &#8211; 1.53 million nuclei per channel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="414" y="68" width="284" height="14" as="geometry" />
