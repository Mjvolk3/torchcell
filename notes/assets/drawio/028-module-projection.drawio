<mxfile><diagram id="module-projection" name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="717" pageHeight="249" math="1" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="11" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;gene tokens&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;h&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; from the backbone on the perturbed graph, the deleted gene's token removed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0.00" y="0.00" width="76.00" height="78.00" as="geometry"/></mxCell><mxCell id="12" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;availability gate&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;&amp;gamma;&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;&amp;sigma;&lt;/i&gt;(&lt;i&gt;w&lt;/i&gt;&amp;middot;&lt;i&gt;h&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt;); a deleted gene is set to 0 hard" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="89.00" y="0.00" width="84.00" height="78.00" as="geometry"/></mxCell><mxCell id="13" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;GPR fold&lt;/b&gt;&lt;/span&gt;&lt;br&gt;reaction availability &lt;i&gt;c&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;: softmin over a complex's subunits, sum over isozymes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="186.00" y="0.00" width="84.00" height="78.00" as="geometry"/></mxCell><mxCell id="14" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;the box&lt;/b&gt;&lt;/span&gt;&lt;br&gt;[&lt;i&gt;lb&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;c&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;, &lt;i&gt;ub&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;c&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;] tightened by the enzyme ceiling &lt;i&gt;k&lt;/i&gt;&lt;sub&gt;cat,&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt; (nominal or predicted abundance)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="283.00" y="0.00" width="106.00" height="78.00" as="geometry"/></mxCell><mxCell id="15" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;alternating projections&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;K&lt;/i&gt; steps between the balance projection onto {&lt;i&gt;S&lt;/i&gt;&lt;i&gt;v&lt;/i&gt; = 0} and the box clip onto [&lt;i&gt;lb&lt;/i&gt;, &lt;i&gt;ub&lt;/i&gt;]; the last one holds exactly" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="402.00" y="0.00" width="120.00" height="78.00" as="geometry"/></mxCell><mxCell id="16" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;growth column&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;growth&lt;/sub&gt;, one coordinate of the flux &lt;i&gt;v&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="535.00" y="0.00" width="64.00" height="78.00" as="geometry"/></mxCell><mxCell id="17" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;readout&lt;/b&gt;&lt;/span&gt;&lt;br&gt;forced: &lt;i&gt;a&lt;/i&gt; &lt;i&gt;v&lt;/i&gt;&lt;sub&gt;growth&lt;/sub&gt; + &lt;i&gt;b&lt;/i&gt;; gated: head(&lt;i&gt;z&lt;/i&gt;) + &lt;i&gt;g&lt;/i&gt; (&lt;i&gt;a&lt;/i&gt; &lt;i&gt;v&lt;/i&gt;&lt;sub&gt;growth&lt;/sub&gt; + &lt;i&gt;b&lt;/i&gt;), &lt;i&gt;g&lt;/i&gt;&lt;sub&gt;0&lt;/sub&gt; = 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="612.00" y="0.00" width="105.00" height="78.00" as="geometry"/></mxCell><mxCell id="18" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="19" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="15" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;whole-cell context&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;z&lt;/i&gt;, the pooled perturbed tokens" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="190.00" y="108.00" width="110.00" height="40.00" as="geometry"/></mxCell><mxCell id="25" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;latent MLP&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;z&lt;/i&gt; &amp;rarr; latent coordinates" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="318.00" y="108.00" width="92.00" height="40.00" as="geometry"/></mxCell><mxCell id="26" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;proposal&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;0&lt;/sub&gt; = &lt;i&gt;N&lt;/i&gt; &lt;i&gt;z&lt;/i&gt;, &lt;i&gt;N&lt;/i&gt; a basis of the null space of &lt;i&gt;S&lt;/i&gt;: &lt;i&gt;S&lt;/i&gt;&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;0&lt;/sub&gt; = 0 exactly" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="428.00" y="108.00" width="150.00" height="40.00" as="geometry"/></mxCell><mxCell id="27" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="24" target="25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="28" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="25" target="26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="26" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="30" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;the constraint set&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;S&lt;/i&gt;&lt;i&gt;v&lt;/i&gt; = 0: exact when the alternation ends on the balance, else a residual&lt;br&gt;&lt;i&gt;lb&lt;/i&gt; &amp;le; &lt;i&gt;v&lt;/i&gt; &amp;le; &lt;i&gt;ub&lt;/i&gt;: exact when it ends on the box, else a penalty&lt;br&gt;second law &lt;i&gt;v&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt; &amp;Delta;&lt;i&gt;G&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt; &amp;le; 0: a hinge, or with tdg a directional box&lt;br&gt;protein pool &amp;Sigma;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; MW&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; &amp;le; &lt;i&gt;p&lt;/i&gt;&lt;sub&gt;avail&lt;/sub&gt;: a hinge&lt;br&gt;Gibbs dissipation: a logged diagnostic; the anchored registry entry carried it as a hinge at nonzero constraint scale" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=left;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0.00" y="164.00" width="440.00" height="84.00" as="geometry"/></mxCell><mxCell id="31" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;measured (rounds 2 to 10)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;never reaches the polytope: 58 percent of reactions out of the box at the balance end, balance residual 0.85 to 2.0 at the box end; the growth column is a free signed coordinate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.8;align=left;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="456.00" y="164.00" width="261.00" height="84.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>