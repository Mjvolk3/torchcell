  "alternatives_rejected": [
    {
      "alternative": "Loosen is_essential to bool | None and store a grade or 'unclear' as a typed ProvenanceGap on the boolean leaf",
      "why_rejected": "A released 'unclear' or GD is reported by the primary, so no ProvenanceGapReason describes it honestly (not_reported_by_primary, not_carried_by_curation, deferred_pending_source_review); and loosening a required field needs owner sign-off (Rule 3). The coordinator relayed the decision that #1066's boolean leaf keeps its contract and the graded calls go to a sibling."
    },
    {
      "alternative": "Collapse the HMM states to a boolean (ES true, GD / NE / GA false) and store them on GeneEssentialityPhenotype",
      "why_rejected": "It discards the GD and GA grades the release states and asserts a conversion the paper does not make; the owner's rule stores every grade as released."
    },
    {
      "alternative": "Carry the HMM statistics on the graded leaf instead of on GeneEssentialityEvidence",
      "why_rejected": "Per-record evidence statistics live on the descriptor for every other evidence type (#924); a second home would split one record's evidence across two objects and leave the descriptor unable to describe the HMM call it types."
    },
    {
      "alternative": "Store Goodall's unclear calls in the boolean store as a second experiment class",
      "why_rejected": "A store holds one experiment class (ExperimentDataset.transform_item retypes every record through it), so the 317 unclear calls are a second, graded store of the same release, and each released call is stored exactly once across the two."
    }
  ],
