  pages = {1463},
  publisher = {Nature Publishing Group},
  title = {The interplay of additivity, dominance, and epistasis on fitness in a diploid yeast cross},
  url = {https://www.nature.com/articles/s41467-022-29111-z},
  urldate = {2026-01-15},
  volume = {13},
