<mxfile host="compose_dango_si_figures.py"><diagram id="FigS-dango-reproduction" name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="1" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="0.0" y="16.0" width="346.4567" height="204.7244" as="geometry"/></mxCell><mxCell id="4" value="a" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=11.1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="18" height="14" as="geometry"/></mxCell><mxCell id="5" value="Six STRING channels as message-passing edges" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingRight=3;spacingTop=0;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="358.5" y="16.0" width="346.5" height="29.1" as="geometry"/></mxCell><mxCell id="6" value="$$\textstyle A^{(k)}\in\{0,1\}^{N\times N},\quad k=1,\dots,6,\quad N=6607$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="29.0" width="346.5" height="16.1" as="geometry"/></mxCell><mxCell id="7" value="Channel encoder, two GraphSAGE layers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingRight=3;spacingTop=0;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="358.5" y="51.1" width="196.0" height="29.1" as="geometry"/></mxCell><mxCell id="8" value="$$\textstyle H^{(k)}=F^{(k)}(\mathbf{E},A^{(k)}),\quad \mathbf{E}\in\mathbb{R}^{N\times d}$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="64.1" width="196.0" height="16.1" as="geometry"/></mxCell><mxCell id="9" value="Reconstruction head" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingRight=3;spacingTop=0;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="560.5" y="51.1" width="144.5" height="29.1" as="geometry"/></mxCell><mxCell id="10" value="$$\textstyle \hat A^{(k)}=H^{(k)}W_k,\quad \mathcal{L}_{\mathrm{rec}}(\lambda_k)$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="560.5" y="64.1" width="144.5" height="16.1" as="geometry"/></mxCell><mxCell id="11" value="Meta-embedding merges the six channels" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingRight=3;spacingTop=0;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="358.5" y="86.2" width="346.5" height="29.1" as="geometry"/></mxCell><mxCell id="12" value="$$\textstyle h_i=\sum\nolimits_k a_{ik}\,h_i^{(k)},\quad a_{i:}=\operatorname{softmax}_k\,\mathrm{MLP}(h_i^{(k)}),\quad H=(h_1,\dots,h_N)$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="99.2" width="346.5" height="16.1" as="geometry"/></mxCell><mxCell id="13" value="Perturbation selects rows; no perturbation operator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingRight=3;spacingTop=0;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="358.5" y="121.4" width="346.5" height="29.1" as="geometry"/></mxCell><mxCell id="14" value="$$\textstyle p=\{g_i,g_j,g_k\}\ \mapsto\ (h_i,h_j,h_k),\quad H\ \text{unchanged}$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="134.4" width="346.5" height="16.1" as="geometry"/></mxCell><mxCell id="15" value="Hyper-SAGNN readout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingRight=3;spacingTop=0;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="358.5" y="156.5" width="176.0" height="29.1" as="geometry"/></mxCell><mxCell id="16" value="$$\textstyle \hat y_{\mathrm{int}}=|p|^{-1}\sum\nolimits_{t\in p}\mathrm{FC}\big((d_t-s_t)^{2}\big)$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="169.5" width="176.0" height="16.1" as="geometry"/></mxCell><mxCell id="17" value="Interaction loss" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingRight=3;spacingTop=0;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="540.5" y="156.5" width="164.5" height="29.1" as="geometry"/></mxCell><mxCell id="18" value="$$\textstyle \mathcal{L}_{\mathrm{int}}=\operatorname{mean}\log\cosh(\hat y_{\mathrm{int}}-y_{\mathrm{int}})$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="540.5" y="169.5" width="164.5" height="16.1" as="geometry"/></mxCell><mxCell id="19" value="Objective; the pretraining weight follows one of three schedules over epochs 1 to 10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.3;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingRight=3;spacingTop=0;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="358.5" y="191.6" width="346.5" height="29.1" as="geometry"/></mxCell><mxCell id="20" value="$$\textstyle \mathcal{L}=\alpha_e\,\mathcal{L}_{\mathrm{rec}}+(1-\alpha_e)\,\mathcal{L}_{\mathrm{int}}$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="358.5" y="204.6" width="346.5" height="16.1" as="geometry"/></mxCell><mxCell id="21" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="456.5" y="45.1" as="sourcePoint"/><mxPoint x="456.5" y="51.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="554.5" y="65.7" as="sourcePoint"/><mxPoint x="560.5" y="65.7" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="456.5" y="80.2" as="sourcePoint"/><mxPoint x="456.5" y="86.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=3;" edge="1" parent="1"><mxGeometry relative="1" as="geo