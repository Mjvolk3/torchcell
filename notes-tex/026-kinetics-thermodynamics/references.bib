  shorttitle = {{TransformerGO}},
  title = {{TransformerGO}: predicting protein–protein interactions by modelling the attention between sets of gene ontology terms},
  url = {https://doi.org/10.1093/bioinformatics/btac104},
  urldate = {2023-10-17},
  volume = {38},
  year = {2022}
}

