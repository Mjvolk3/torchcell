    {
      "gate": "G3",
      "outcome": "pass",
      "reason": "54 file(s) in library+raw, 59352 worksheet row(s) counted; all intact",
      "evidence": [
        {
          "value": "data availability: PubChem holds only the high-confidence subset; the full matrix is the SI",
          "provenance": {
            "source_uri": "paper.md",
            "citation_key": "piotrowskiFunctionalAnnotationChemical2017",
            "sha256": "9314a0dd932c1b20b4dc4297de4ce9452b09f314bf100f05f2fe718fb3415fc1",
            "method": null,
            "page": null,
            "retrieved": null
          },
          "quote": "All high-confidence chemical-genetic data and associated compound information has been deposited to PubChem",
          "note": null
        },
        {
          "value": "replicates: 3 technical PCR replicates by design; each Data Set 5 profile averages those the batch-effect filter kept and the correlation graph joined (1 to 3, not released per profile)",
          "provenance": {
            "source_uri": "paper.md",
            "citation_key": "piotrowskiFunctionalAnnotationChemical2017",
            "sha256": "9314a0dd932c1b20b4dc4297de4ce9452b09f314bf100f05f2fe718fb3415fc1",
            "method": null,
            "page": null,
            "retrieved": null
          },
          "quote": "The genomic extractions for each plate were amplified in triplicate using three unique multiplex primer plates (three technical replicates).",
          "note": null
        },
        {
          "value": "replicate collapsing: a released profile is the mean of the technical replicates the correlation graph joined",
          "provenance": {
            "source_uri": "si/si1.docx",
            "citation_key": "piotrowskiFunctionalAnnotationChemical2017",
            "sha256": "38cddea8f1a497107304599271bcfcabfba7f65a4f7b3b616f26923be119959a",
            "method": "paragraph text of word/document.xml (the w:t runs of each w:p concatenated); the NIHMS884855 Supplementary Note",
            "page": "Supplementary Note, 'Chemical-genetic interaction scoring method'",
            "retrieved": null
          },
          "quote": "In the “replicate collapsing” step, profiles from technical replicate conditions were collapsed into single, mean profiles. To determine which replicates would be collapsed into each final profile, a graph was constructed in which nodes were the technical replicates and edges indicated a correlation between two replicates above a certain threshold (“replicate correlation threshold”).",
          "note": "a released profile is the mean of the replicates the correlation graph joined, and the batch-effect filter removed whole multiplex tags before that, so the count behind a profile is between 1 and the design's 3 and is not released"
        },
        {
          "value": "matrix: Data Set 5 titles 11,983 profiles; it carries 11,984 columns, the extra one (Cond-008510) marked In_final_dataset = False in Data Set 4; its 291 rows name 289 pool strains (TCD1 and TCD2 labelled by ORF in the RIKEN columns)",
          "provenance": {
            "source_uri": "si/si13.xlsx",
            "citation_key": "piotrowskiFunctionalAnnotationChemical2017",
            "sha256": "96e07f956f7edeb07359fc8b1fa5c72a167bf9bb18d1e8a680c76362e97aaefd",
            "method": "cell value read with openpyxl (read_only, data_only)",
            "page": "sheet 'All_conditions', cell A1",
            "retrieved": null
          },
          "quote": "Supplementary dataset 5. Average chemical genomic profile of 11983 compounds",
          "note": "the release carries 11,984 columns; the extra one is Cond-008510 (NPE1123), which Data Set 4 marks In_final_dataset = False"
        }
      ],
      "issue": null,
      "blocked_kind": null
    },
