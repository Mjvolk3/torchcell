        <mxCell id="b4" value="captured on the bead&#10;oligo, then RT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="440" y="186" width="108" height="24" as="geometry" />
        </mxCell>

        <mxCell id="tb1" value="on ice + 6 min run" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="118" y="228" width="180" height="12" as="geometry" />
        </mxCell>
        <mxCell id="tb2" value="53 &#176;C, 20 min" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="298" y="228" width="260" height="12" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="cell counts hold" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="118" y="242" width="180" height="11" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="counts drop 200-fold: the wall is gone, inside a container" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="298" y="242" width="260" height="11" as="geometry" />
        </mxCell>

        <mxCell id="warn" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="572" y="178" width="130" height="64" as="geometry" />
        </mxCell>
        <mxCell id="warnt" value="What this avoids" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="578" y="179" width="118" height="11" as="geometry" />
        </mxCell>
        <mxCell id="warnb" value="Spheroplasting &lt;i&gt;before&lt;/i&gt; loading shears wall-less cells in the chip, and the mRNA released contaminates every droplet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="578" y="191" width="118" height="46" as="geometry" />
