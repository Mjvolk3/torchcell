        <mxCell id="b7" value="INFERRED&#10;blocks" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="8" y="258" width="116" height="24" as="geometry"/></mxCell>
