        <mxCell id="s5h2" value="PCR handle&#10;(R2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="564" y="449" width="66" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s5e3" value="3&#8242;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="632" y="449" width="16" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s5new" value="new" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="564" y="472" width="66" height="11"  as="geometry" />
        </mxCell>

        <mxCell id="a56" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#666666;endSize=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="131" y="487" as="sourcePoint" />
            <mxPoint x="131" y="517" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n56" value="&lt;b&gt;A template switch on the beads adds a common handle to the far 3&#8242; end,&lt;/b&gt; giving the molecule a PCR primer site at both ends. Everything downstream is conventional Illumina library prep." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="154" y="487" width="548" height="24"  as="geometry" />
        </mxCell>

        <!-- ============================ STEP 6 ============================ -->
        <mxCell id="t6" value="6. Amplify, fragment,&#10;adapter-ligate, index" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
