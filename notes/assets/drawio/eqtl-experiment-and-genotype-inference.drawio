        <mxCell id="bb2" value="A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1"><mxGeometry x="418" y="258" width="102" height="20" as="geometry"/></mxCell>
        <mxCell id="bb3" value="B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1"><mxGeometry x="550" y="258" width="144" height="20" as="geometry"/></mxCell>
        <mxCell id="bu0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1"><mxGeometry x="238" y="254" width="30" height="28" as="geometry"/></mxCell>
        <mxCell id="bu1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1"><mxGeometry x="388" y="254" width="30" height="28" as="geometry"/></mxCell>
        <mxCell id="bu2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1"><mxGeometry x="520" y="254" width="30" height="28" as="geometry"/></mxCell>
        <mxCell id="bgc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;dashed=1;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1"><mxGeometry x="462" y="258" width="18" height="20" as="geometry"/></mxCell>
        <mxCell id="bgca" style="endArrow=classic;html=1;strokeWidth=1;strokeColor=#B85450;endSize=4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="471" y="300" as="sourcePoint"/><mxPoint x="471" y="279" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b8" value="the ramp IS the uncertainty:&#10;a crossover is placed only to&#10;within one marker interval" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="196" y="288" width="156" height="34" as="geometry"/></mxCell>
        <mxCell id="b9" value="a gene conversion tract sits&#10;BETWEEN markers, so no read&#10;reports it and no ramp appears" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="396" y="302" width="160" height="34" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b&gt;Why sparse reads still suffice.&lt;/b&gt; The segregant is never sequenced de novo. At each locus it is ASSIGNED to one of two already-sequenced genomes. Meiosis makes &#8776;90 crossovers, so a genome is &#8776;10&#178; blocks, and one marker fixes every cataloged variant in its block. The task is locating &#8776;10&#178; boundaries, not determining &#8776;10&#8308; values." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=8.5;align=left;verticalAlign=top;spacingLeft=5;spacingTop=3;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="8" y="342" width="336" height="62" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;b&gt;What no marker density fixes.&lt;/b&gt; Boundary intervals leave &#8776;0.8% of cataloged sites ambiguous. Non-crossover gene conversion (&#8776;46 per meiosis, &#8776;2 kb) affects more bases than that and is invisible to sparse markers. De novo mutation, aneuploidy and non-reference sequence sit outside the mosaic model entirely." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;align=left;verticalAlign=top;spacingLeft=5;spacingTop=3;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="358" y="342" width="336" height="62" as="geometry"/></mxCell>
        <mxCell id="pc" value="&lt;b&gt;c&lt;/b&gt;&#160;&#160;What the two matrices look like" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="8" y="418" width="360" height="14" as="geometry"/></mxCell>
        <mxCell id="c0" value="&lt;b&gt;X&lt;/b&gt;&#160;&#160;n segregants &#215; m markers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="76" y="440" width="160" height="12" as="geometry"/></mxCell>
