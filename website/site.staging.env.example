# website/site.staging.env.example
# Build settings of the STAGING site. Copy to website/site.staging.env (git-ignored),
# set the host, then `make site-build TIER=staging` from the repo root. The staging site
# calls the staging API only (docker/tc-bench/tc-bench.staging.env.example).
SITE_ENV=staging
SITE_URL=https://torchcell-database.ncsa.illinois.edu
BASE_URL=/staging/
BENCH_API_URL=https://torchcell-database.ncsa.illinois.edu/staging/api/v1
ONTOLOGY_EXPLORER_URL=https://mjvolk3.github.io/torchcell/ontology/
# Where `make site-publish TIER=staging` copies the build: the directory
# docker/tc-proxy/Caddyfile serves for this tier (read-only mount in
# docker-compose.tc-proxy.yml).
SITE_PUBLISH_DIR=/home/rocky/srv/tc-site/staging
