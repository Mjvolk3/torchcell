@article{fulcherParallelMeasurementTranscriptomes2024,
  title = {Parallel Measurement of Transcriptomes and Proteomes from Same Single Cells Using Nanodroplet Splitting},
  author = {Fulcher, James M. and Markillie, Lye Meng and Mitchell, Hugh D. and Williams, Sarah M. and Engbrecht, Kristin M. and Degnan, David J. and Bramer, Lisa M. and Moore, Ronald J. and Chrisler, William B. and {Cantlon-Bruce}, Joshua and Bagnoli, Johannes W. and Qian, Wei-Jun and Seth, Anjali and {Pa{\v s}a-Toli{\'c}}, Ljiljana and Zhu, Ying},
  year = 2024,
