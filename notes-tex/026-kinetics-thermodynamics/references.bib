  shorttitle = {Universal {Cell} {Embeddings}},
  title = {Universal {Cell} {Embeddings}: {A} {Foundation} {Model} for {Cell} {Biology}},
  url = {https://www.biorxiv.org/content/10.1101/2023.11.28.568918v1},
  urldate = {2023-12-13},
