<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram name="scrnaseq-method-taxonomy" id="scrnaseqMethodTaxonomy">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="703" pageHeight="526" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================================================================
             TRUE-SIZE CANVAS. 100 draw.io units = 1 inch. 0..702 x 0..~470.
             Arial; 8.5 units = 6.1 pt (Nature 6 pt min); title 12.
             Palette = PLOT_PALETTE / PLOT_PALETTE_FILL slots 1-6; segment
             colors match Figs. 2 and 4 (splitseq-barcoding, droplet-10x).
             A clearer redraw of Fig. 1 of Nadal-Ribelles 2024. Reorganized
             around the question that figure hides: WHICH MOLECULE CARRIES
             THE CELL BARCODE; and with one fixed 5'->3' orientation
             throughout (the original mirrors its 3' panel).
             Panel c column grid, shared by all three rows:
               P5 136..176 | R1 176..236 | CB 236..286 | UMI 286..330
               cDNA 330..520 | R2 520..580 | index 580..624 | P7 624..664
             ================================================================ -->

        <mxCell id="title" value="Yeast scRNA-seq methods: what separates the cells, and which molecule carries the cell barcode" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=9.3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="698" height="15" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A redrawing of Fig. 1 of Nadal-Ribelles 2024, reorganized around the one question that separates the library types. Every molecule is drawn in a single fixed orientation, 5&#8242; left to 3&#8242; right with P5 always on the left, and colors are those of Figs. 2 and 4." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="17" width="698" height="24" as="geometry" />
        </mxCell>

        <!-- ============================= PANEL a ============================= -->
        <mxCell id="pa" value="a" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10.9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="48" width="10" height="12" as="geometry" />
        </mxCell>
        <mxCell id="pah" value="What keeps one cell's molecules separate from another's" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="13" y="48" width="500" height="12" as="geometry" />
        </mxCell>

        <mxCell id="paNote" value="Six options, ordered by throughput. The last one is not an isolation method at all." style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="70" width="112" height="46" as="geometry" />
        </mxCell>

        <mxCell id="thr" style="endArrow=classic;html=1;strokeWidth=1;strokeColor=#666666;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="118" y="70" as="sourcePoint" /><mxPoint x="692" y="70" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="thrl" value="cells profiled per experiment" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="118" y="58" width="200" height="11" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="Microfluidic&#10;chip (C1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="118" y="76" width="88" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="FACS into&#10;plates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="217" y="76" width="88" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Micro-&#10;dissection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="316" y="76" width="88" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Droplet&#10;(10x, Drop-seq)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="415" y="76" width="88" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Microwell&#10;array" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="514" y="76" width="88" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="Combinatorial&#10;indexing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;dashed=1;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="613" y="76" width="88" height="24" as="geometry" />
        </mxCell>

        <mxCell id="a1n" value="up to 96 per chip&#10;one chamber per cell" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="118" y="102" width="88" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a2n" value="~285 cells&#10;one well per cell" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="217" y="102" width="88" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a3n" value="~2,000 cells&#10;one well per cell" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="316" y="102" width="88" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a4n" value="6,000&#8211;100,000&#10;an oil-walled droplet&#10;152,000 preindexed&#10;(human; Fig. 5)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="415" y="102" width="88" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a5n" value="up to 1,061,865&#10;a printed microwell" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="514" y="102" width="88" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a6n" value="25,000&#8211;240,000 per run&#10;&lt;b&gt;nothing: the fixed cell is its own container&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="605" y="102" width="93" height="34" as="geometry" />
        </mxCell>

        <mxCell id="phen" value="per-cell phenotype recorded (imaging, reporters, sorting gates)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="118" y="152" width="286" height="14" as="geometry" />
        </mxCell>
        <mxCell id="nophen" value="no per-cell phenotype; cells are pooled and read out only by sequence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="415" y="152" width="283" height="14" as="geometry" />
        </mxCell>

        <!-- ============================= PANEL b ============================= -->
        <mxCell id="pb" value="b" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10.9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="168" width="10" height="12" as="geometry" />
        </mxCell>
        <mxCell id="pbh" value="The question that separates the library types: which molecule carries the cell barcode?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="13" y="168" width="560" height="12" as="geometry" />
        </mxCell>

        <mxCell id="pbNote" value="Four answers. The original figure draws the products; this draws the choice that produces them." style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="190" width="112" height="56" as="geometry" />
        </mxCell>

        <mxCell id="b1h" value="the oligo-dT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="118" y="190" width="138" height="14" as="geometry" />
        </mxCell>
        <mxCell id="b2h" value="the TSO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="266" y="190" width="138" height="14" as="geometry" />
        </mxCell>
        <mxCell id="b3h" value="the Tn5 adapter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="414" y="190" width="138" height="14" as="geometry" />
        </mxCell>
        <mxCell id="b4h" value="nothing in the molecule" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="562" y="190" width="138" height="14" as="geometry" />
        </mxCell>

        <mxCell id="b1cb" value="CB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="128" y="210" width="42" height="18" as="geometry" />
        </mxCell>
        <mxCell id="b1umi" value="UMI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="170" y="210" width="40" height="18" as="geometry" />
        </mxCell>
        <mxCell id="b1dt" value="dT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="210" y="210" width="36" height="18" as="geometry" />
        </mxCell>
        <mxCell id="b2cb" value="CB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="276" y="210" width="42" height="18" as="geometry" />
        </mxCell>
        <mxCell id="b2umi" value="UMI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="318" y="210" width="40" height="18" as="geometry" />
        </mxCell>
        <mxCell id="b2gg" value="rGrGrG" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="358" y="210" width="42" height="18" as="geometry" />
        </mxCell>
        <mxCell id="b3tn" value="Tn5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="440" y="210" width="30" height="18" as="geometry" />
        </mxCell>
        <mxCell id="b3cb" value="CB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="472" y="210" width="42" height="18" as="geometry" />
        </mxCell>
        <mxCell id="b4none" value="the well &lt;i&gt;is&lt;/i&gt; the barcode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;dashed=1;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="210" width="102" height="18" as="geometry" />
        </mxCell>

        <mxCell id="b1n" value="&lt;b&gt;3&#8242; end libraries.&lt;/b&gt; Barcode is on the primer, so it lands next to the poly(A) end. Droplet, microwell, combinatorial indexing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="118" y="234" width="138" height="46" as="geometry" />
        </mxCell>
        <mxCell id="b2n" value="&lt;b&gt;5&#8242; end libraries.&lt;/b&gt; Barcode rides the template-switch oligo, so it lands at the transcript's 5&#8242; end. Commercial droplet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="266" y="234" width="138" height="46" as="geometry" />
        </mxCell>
        <mxCell id="b3n" value="&lt;b&gt;5&#8242; end, plate route.&lt;/b&gt; Neither oligo is barcoded; identity is added later, at tagmentation. yscRNA-seq, the only 5&#8242; method run in yeast." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="414" y="234" width="138" height="46" as="geometry" />
        </mxCell>
        <mxCell id="b4n" value="&lt;b&gt;Full-length.&lt;/b&gt; Tn5 carries universal adapters; the cell is identified by which well the library came from. SMART-seq2, plate only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="562" y="234" width="138" height="46" as="geometry" />
        </mxCell>

