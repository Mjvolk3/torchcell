<mxfile><diagram id="module-lp" name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="717" pageHeight="233" math="1" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="11" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;gene tokens&lt;/b&gt;&lt;/span&gt;&lt;br&gt;\(h_g\) from the backbone, perturbed graph" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0.00" y="0.00" width="66.00" height="88.00" as="geometry"/></mxCell><mxCell id="12" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;abundance head&lt;/b&gt;&lt;/span&gt;&lt;br&gt;\(E_g=\gamma_g E^0_g\,\cdot\)&lt;br&gt;\(\exp(r\tanh(w^{\top}h_g))\)&lt;br&gt;\(\gamma_g\) hard (1 present, 0 deleted), no learned gate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="79.00" y="0.00" width="112.00" height="88.00" as="geometry"/></mxCell><mxCell id="13" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;unit abundance&lt;/b&gt;&lt;/span&gt;&lt;br&gt;\(E_u\): power mean over a complex's subunits, sum over isozymes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="204.00" y="0.00" width="80.00" height="88.00" as="geometry"/></mxCell><mxCell id="14" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;box&lt;/b&gt;&lt;/span&gt;&lt;br&gt;\(|v_j|\le k_{\mathrm{cat},u}E_u\) times the scale, inside \([\ell_j,u_j]\) scaled by availability" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="297.00" y="0.00" width="100.00" height="88.00" as="geometry"/></mxCell><mxCell id="15" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;growth LP&lt;/b&gt;&lt;/span&gt;&lt;br&gt;\(\max\ v_{\mathrm{growth}}\) s.t. \(Sv=0,\ \ell\le v\le u\)&lt;br&gt;HiGHS per genotype in a forked pool" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="410.00" y="0.00" width="130.00" height="88.00" as="geometry"/></mxCell><mxCell id="16" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;optimum&lt;/b&gt;&lt;/span&gt;&lt;br&gt;\(v^*\), \(z^*\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="553.00" y="0.00" width="44.00" height="88.00" as="geometry"/></mxCell><mxCell id="17" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;readout&lt;/b&gt;&lt;/span&gt;&lt;br&gt;forced: \(\ell=a\,z^*+b\)&lt;br&gt;gated: \(\ell=\mathrm{head}(z)\)&lt;br&gt;\(+\,g\,(a\,z^*+b)\)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="610.00" y="0.00" width="107.00" height="88.00" as="geometry"/></mxCell><mxCell id="18" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="19" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="15" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475.00" y="114.00"/><mxPoint x="135.00" y="114.00"/></Array></mxGeometry></mxCell><mxCell id="25" value="backward: \(\partial z^*/\partial u_j\) is the dual of the ceiling (envelope theorem), nonzero only where the bound binds; through \(E_g\) to the backbone" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="145.00" y="118.00" width="320.00" height="24.00" as="geometry"/></mxCell><mxCell id="26" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;by construction&lt;/b&gt;&lt;/span&gt;&lt;br&gt;\(Sv=0\) and \(\ell\le v\le u\) hold exactly at \(v^*\), the ceilings with them&lt;br&gt;\(v^*\) is piecewise constant in the bounds and carries no gradient; only \(z^*\) does&lt;br&gt;the forced flux of the maintenance reaction (\(\ell=0.7\) mmol/gDW/h) must be carried inside the ceilings" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=left;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0.00" y="154.00" width="440.00" height="78.00" as="geometry"/></mxCell><mxCell id="27" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;measured (rounds 15 to 15d)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;an infeasible program returns the zero flux and no gradient, so the state is absorbing (rounds 15b to 15d); duals on exchange bounds belong to no gene, so with no ceiling binding the backbone receives nothing (round 15b)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.8;align=left;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="456.00" y="154.00" width="261.00" height="78.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>