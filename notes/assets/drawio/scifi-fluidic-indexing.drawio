        <mxCell id="pcNote" value="Read the molecule against Fig. 2: identical grammar, but the second barcode is delivered by a droplet rather than by a second plate." style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
