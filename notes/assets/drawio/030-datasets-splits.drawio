<mxfile><diagram id="datasets-splits" name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="702" pageHeight="356" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="11" value="a" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11.1;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.00" y="0.00" width="14.00" height="14.00" as="geometry"/></mxCell><mxCell id="12" value="Three builds of the same screens, one pool of records" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16.00" y="0.00" width="500.00" height="14.00" as="geometry"/></mxCell><mxCell id="13" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;010 build: triples only&lt;/b&gt;&lt;/span&gt;&lt;br&gt;the 376,732 Kuzmin 2018 and 2020 trigenic records, one value per label (the mean over sources); no singles, no doubles. The model sees only gene identity and the triple's own score." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.8;align=left;verticalAlign=top;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0.00" y="18.00" width="222.00" height="84.00" as="geometry"/></mxCell><mxCell id="14" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;025 closure pool S3, labels merged&lt;/b&gt;&lt;/span&gt;&lt;br&gt;every single (5,694), every double whose gene pair lies inside some triple (739,236) and every triple (376,732): 1,121,645 records. One value per label, the mean over sources, so a converted 0 can average with a measurement." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.8;align=left;verticalAlign=top;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="240.00" y="18.00" width="222.00" height="84.00" as="geometry"/></mxCell><mxCell id="15" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;030 per-entry pool, nothing merged&lt;/b&gt;&lt;/span&gt;&lt;br&gt;the same pool, 1,121,662 records, keeps every source entry: 4,860,168 entry rows (23,509 on singles, 4,054,063 on doubles, 782,596 on triples), each tagged with its source dataset, and the double-mutant query strain's own fitness beside the array screen's." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.8;align=left;verticalAlign=top;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="480.00" y="18.00" width="222.00" height="84.00" as="geometry"/></mxCell><mxCell id="16" value="" style="endArrow=blockThin;endFill=1;endSize=4;html=1;strokeColor=#000000;strokeWidth=0.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="" style="endArrow=blockThin;endFill=1;endSize=4;html=1;strokeColor=#000000;strokeWidth=0.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="b" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11.1;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.00" y="118.00" width="14.00" height="14.00" as="geometry"/></mxCell><mxCell id="19" value="One triple {i, j, k} of query pair ij and array gene k, the records the published identity reads, and which of them train" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16.00" y="118.00" width="686.00" height="14.00" as="geometry"/></mxCell><mxCell id="20" value="&amp;#964;&lt;sub&gt;ijk&lt;/sub&gt; = f&lt;sub&gt;ijk&lt;/sub&gt; &amp;#8722; f&lt;sub&gt;ij&lt;/sub&gt; f&lt;sub&gt;k&lt;/sub&gt; &amp;#8722; &amp;#949;&lt;sub&gt;ik&lt;/sub&gt; &amp;#8722; &amp;#949;&lt;sub&gt;jk&lt;/sub&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;filled: a training record&amp;#160;&amp;#160;&amp;#160;&amp;#160;white, dashed: withheld from training" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="0.00" y="136.00" width="702.00" height="14.00" as="geometry"/></mxCell><mxCell id="21" value="singles" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.00" y="154.00" width="228.00" height="12.00" as="geometry"/></mxCell><mxCell id="22" value="query double" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="318.00" y="154.00" width="72.00" height="12.00" as="geometry"/></mxCell><mxCell id="23" value="array doubles" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="410.00" y="154.00" width="150.00" height="12.00" as="geometry"/></mxCell><mxCell id="24" value="the triple" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="580.00" y="154.00" width="72.00" height="12.00" as="geometry"/></mxCell><mxCell id="25" value="arm R" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.00" y="168.00" width="64.00" height="30.00" as="geometry"/></mxCell><mxCell id="26" value="f&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="70.00" y="168.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="27" value="f&lt;sub&gt;j&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="148.00" y="168.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="28" value="f&lt;sub&gt;k&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="226.00" y="168.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="29" value="f&lt;sub&gt;ij&lt;/sub&gt;, &amp;#949;&lt;sub&gt;ij&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFE6CC;" vertex="1" parent="1"><mxGeometry x="318.00" y="168.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="30" value="f&lt;sub&gt;ik&lt;/sub&gt;, &amp;#949;&lt;sub&gt;ik&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFE6CC;" vertex="1" parent="1"><mxGeometry x="410.00" y="168.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="31" value="f&lt;sub&gt;jk&lt;/sub&gt;, &amp;#949;&lt;sub&gt;jk&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFE6CC;" vertex="1" parent="1"><mxGeometry x="488.00" y="168.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="32" value="f&lt;sub&gt;ijk&lt;/sub&gt;, &amp;#964;&lt;sub&gt;ijk&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#9673A6;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFFFFF;dashed=1;dashPattern=3 2;" vertex="1" parent="1"><mxGeometry x="580.00" y="168.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="33" value="arm Q" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.00" y="206.00" width="64.00" height="30.00" as="geometry"/></mxCell><mxCell id="34" value="f&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="70.00" y="206.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="35" value="f&lt;sub&gt;j&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="148.00" y="206.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="36" value="f&lt;sub&gt;k&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="226.00" y="206.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="37" value="f&lt;sub&gt;ij&lt;/sub&gt;, &amp;#949;&lt;sub&gt;ij&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFFFFF;dashed=1;dashPattern=3 2;" vertex="1" parent="1"><mxGeometry x="318.00" y="206.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="38" value="f&lt;sub&gt;ik&lt;/sub&gt;, &amp;#949;&lt;sub&gt;ik&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFE6CC;" vertex="1" parent="1"><mxGeometry x="410.00" y="206.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="39" value="f&lt;sub&gt;jk&lt;/sub&gt;, &amp;#949;&lt;sub&gt;jk&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFE6CC;" vertex="1" parent="1"><mxGeometry x="488.00" y="206.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="40" value="f&lt;sub&gt;ijk&lt;/sub&gt;, &amp;#964;&lt;sub&gt;ijk&lt;/sub&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;strokeColor=#9673A6;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=1;fillColor=#FFFFFF;dashed=1;dashPattern=3 2;" vertex="1" parent="1"><mxGeometry x="580.00" y="206.00" width="72.00" height="30.00" as="geometry"/></mxCell><mxCell id="41" value="On both arms the held-out triple's own fitness and score leave together, since a record carries all of a genotype's entries. On arm Q the held-out query pair's double leaves as well; the array gene, the singles and the array-side doubles stay." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.00" y="244.00" width="632.00" height="26.00" as="geometry"/></mxCell><mxCell id="42" value="c" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11.1;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.00" y="274.00" width="14.00" height="14.00" as="geometry"/></mxCell><mxCell id="43" value="The two arms, every count from the split artifacts" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16.00" y="274.00" width="500.00" height="14.00" as="geometry"/></mxCell><mxCell id="44" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;Arm R: random over triples&lt;/b&gt;&lt;/span&gt;&lt;br&gt;the 010 split carried by gene-set identity: 301,386 train, 37,673 validation, 37,673 test triples; every single and every closure double trains; a held-out triple's query pair, array gene and all six lower-order records are in training." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.8;align=left;verticalAlign=top;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0.00" y="292.00" width="342.00" height="64.00" as="geometry"/></mxCell><mxCell id="45" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;Arm Q: query-pair disjoint&lt;/b&gt;&lt;/span&gt;&lt;br&gt;420 recurring query pairs, 89 held out with every triple they appear in: 301,236 train, 37,705 validation, 37,791 test triples; the 88 doubles whose pair is held out leave training, so f&lt;sub&gt;ij&lt;/sub&gt; and &amp;#949;&lt;sub&gt;ij&lt;/sub&gt; are never seen; array genes are shared across the split." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.8;align=left;verticalAlign=top;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="360.00" y="292.00" width="342.00" height="64.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>