  "alternatives_rejected": [
    {
      "alternative": "Refuse Li 2021 because the control map is absent (issue #800's original recommendation)",
      "why_rejected": "The owner reversed it on 2026-10-12: the absent map is a typed gap on the reference, never a reason to refuse the three released maps."
    },
    {
      "alternative": "Borrow BW-P04's block, or an average of the released blocks, as the control map",
      "why_rejected": "It would store another strain's fit as the control's; the release does not state the control's map."
    },
    {
      "alternative": "Store Baba's OD600 as MeasurementType.growth_rate or cell_yield",
      "why_rejected": "Both are different physical quantities (a fitted rate, a cell count); reusing either changes what the member means (Rule 3, field_meaning)."
    },
    {
      "alternative": "Make EnvironmentResponseExperimentReference.phenotype_reference optional",
      "why_rejected": "Loosens a required field for a thin source (Rule 5); the value-or-gap on the reading keeps the reference, its environment and its strain stated."
    }
  ],
