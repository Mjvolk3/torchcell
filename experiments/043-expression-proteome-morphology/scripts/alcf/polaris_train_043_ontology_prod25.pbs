#!/bin/bash -l
#PBS -A GenesisHackathonOct26
#PBS -q prod
#PBS -l select=25:ncpus=64:ngpus=4
#PBS -l walltime=02:00:00
#PBS -l filesystems=home:eagle
#PBS -N 043-lane25
#PBS -j oe
#PBS -o /eagle/GenesisHackathonOct26/mjvolk3/torchcell/experiments/043-expression-proteome-morphology/slurm/output/
# experiments/043-expression-proteome-morphology/scripts/alcf/polaris_train_043_ontology_prod25.pbs
# [[experiments.043-expression-proteome-morphology.scripts.alcf.polaris_train_043_ontology_prod25]]
# https://github.com/Mjvolk3/torchcell/tree/main/experiments/043-expression-proteome-morphology/scripts/alcf/polaris_train_043_ontology_prod25.pbs
#
# Polaris prod lane, 25-node MEDIUM copy (2026-10-25): 25 nodes x 4 A100 = 100 ranks, 2 h walltime.
# -q prod routes by node count, and 25 nodes is the smallest `medium` job (25-99 nodes, 6 h max), so
# this is the shortest-walltime shape in medium. Same claim lane as the 11- and 24-node copies
# (rank_cell_043.sh, claims_polaris_lane/ on eagle): polaris_cells_043.tsv, then
# polaris_cells_043_seeds.tsv, then polaris_cells_043_seeds100.tsv (EXTRA_CELLS, in that claim
# order), 96 cells; at most 96 of the 100 ranks hold a cell. 50 node-hours per copy.
#
#   ssh polaris "cd /eagle/GenesisHackathonOct26/mjvolk3/torchcell && qsub experiments/043-expression-proteome-morphology/scripts/alcf/polaris_train_043_ontology_prod25.pbs"
set -euo pipefail
cd /eagle/GenesisHackathonOct26/mjvolk3/torchcell
echo "job $PBS_JOBID on $(sort -u "$PBS_NODEFILE" | tr '\n' ' ') at $(date); tree $(cut -c1-9 .synced_commit)"
rc=0
mpiexec -n 100 --ppn 4 --depth 16 --cpu-bind depth \
  env EXTRA_CELLS="polaris_cells_043_seeds.tsv polaris_cells_043_seeds100.tsv" bash experiments/043-expression-proteome-morphology/scripts/alcf/rank_cell_043.sh || rc=$?
echo "done $(date) rc $rc"
exit "$rc"
