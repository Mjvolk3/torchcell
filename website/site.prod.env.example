# website/site.prod.env.example
# Build settings of the PRODUCTION site. Copy to website/site.prod.env (git-ignored),
# set the host, then `make site-build TIER=prod` from the repo root, at the commit the
# promoted API image was built from. The production site calls the production API only
# (docker/tc-bench/tc-bench.prod.env.example).
SITE_ENV=production
SITE_URL=https://example.org
BASE_URL=/
BENCH_API_URL=https://example.org/api/v1
ONTOLOGY_EXPLORER_URL=https://mjvolk3.github.io/torchcell/ontology/
