# website/site.staging.env.example
# Build settings of the STAGING site. Copy to website/site.staging.env (git-ignored),
# set the host, then `make site-build TIER=staging` from the repo root. The staging site
# calls the staging API only (docker/tc-bench/tc-bench.staging.env.example).
SITE_ENV=staging
SITE_URL=https://staging.example.org
BASE_URL=/
BENCH_API_URL=https://staging.example.org/api/v1
ONTOLOGY_EXPLORER_URL=https://mjvolk3.github.io/torchcell/ontology/
