        <mxCell id="b3" value="A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="378" y="234" width="140" height="22" as="geometry" />
