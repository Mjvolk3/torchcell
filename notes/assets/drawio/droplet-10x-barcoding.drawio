        <mxCell id="ctranst" value="Break the emulsion and pool &#8211; from here on it is bulk chemistry: template switch, PCR, fragment, adapter-ligate, dual index." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
