          </mxGeometry>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;Same chemistry, richer oligo:&lt;/b&gt; BC3 plus a 10 nt UMI plus a 5&#8242; biotin, then EDTA terminates. Three rounds of 96 give 96&#179; = 884,736 distinct paths; the UMI (4&#185;&#8304; &#8776; 10&#8310; states) turns read counts into molecule counts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="154" y="355" width="548" height="24"  as="geometry" />
        </mxCell>

        <!-- ============================ STEP 4 ============================ -->
        <mxCell id="t4" value="4. Sublibraries, lysis&#10;streptavidin capture" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="389" width="108" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s4bead" value="SA" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="112" y="389" width="20" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s4bio" value="B" style="ellipse;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#333333;strokeWidth=2;fontFamily=Arial;fontSize=8.5;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="135" y="389" width="16" height="22"  as="geometry" />
