        <mxCell id="bu1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1"><mxGeometry x="388" y="254" width="30" height="28" as="geometry"/></mxCell>
        <mxCell id="bu2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1"><mxGeometry x="520" y="254" width="30" height="28" as="geometry"/></mxCell>
        <mxCell id="bgc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;dashed=1;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1"><mxGeometry x="484" y="258" width="18" height="20" as="geometry"/></mxCell>
        <mxCell id="bgca" style="endArrow=classic;html=1;strokeWidth=1;strokeColor=#B85450;endSize=4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="493" y="300" as="sourcePoint"/><mxPoint x="493" y="279" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b8" value="the ramp IS the uncertainty:&#10;a crossover is placed only to&#10;within one marker interval" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="196" y="288" width="156" height="34" as="geometry"/></mxCell>
        <mxCell id="b9" value="a gene conversion tract sits&#10;BETWEEN markers, so no read&#10;reports it and no ramp appears" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="396" y="302" width="160" height="34" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b&gt;Why sparse reads suffice.&lt;/b&gt;&#10;Each locus is ASSIGNED to one of two sequenced parents.&#10;&#8776;90 crossovers &#8594; &#8776;10&#178; blocks; one marker fixes every variant in its block." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=8.5;align=left;verticalAlign=top;spacingLeft=5;spacingTop=3;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="8" y="342" width="336" height="56" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;b&gt;What no marker fixes.&lt;/b&gt;&#10;Boundary intervals: &#8776;0.8% of sites ambiguous.&#10;Gene conversion (&#8776;46 per meiosis, &#8776;2 kb): invisible between markers.&#10;De novo mutation, aneuploidy, non-reference sequence: outside the model." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;align=left;verticalAlign=top;spacingLeft=5;spacingTop=3;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="358" y="342" width="336" height="56" as="geometry"/></mxCell>
        <mxCell id="pc" value="&lt;b&gt;c&lt;/b&gt;&#160;&#160;What the two matrices look like" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="8" y="414" width="360" height="14" as="geometry"/></mxCell>
        <mxCell id="c0" value="&lt;b&gt;X&lt;/b&gt;&#160;&#160;n segregants &#215; m markers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="76" y="436" width="160" height="12" as="geometry"/></mxCell>
