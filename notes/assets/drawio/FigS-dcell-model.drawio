 parent="1"><mxGeometry x="462" y="104" width="240" height="16" as="geometry"/></mxCell><mxCell id="c54" value="loss = MSE(&amp;#375;, y) + &amp;#945; &amp;#183; mean&lt;sub&gt;t &amp;#8800; r&lt;/sub&gt; MSE(&amp;#375;&lt;sub&gt;t&lt;/sub&gt;, y),&amp;nbsp; &amp;#945; = 0.3&lt;br&gt;weight decay in AdamW replaces &amp;#955;&amp;#8214;W&amp;#8214;&lt;sub&gt;2&lt;/sub&gt;; init U(&amp;#8722;0.001, 0.001)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;strokeColor=#666666;fillColor=#F5F5F5;strokeWidth=0.75;spacingLeft=3;" vertex="1" parent="1"><mxGeometry x="462" y="126" width="240" height="30" as="geometry"/></mxCell><mxCell id="c55" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582.0" y="74" as="sourcePoint"/><mxPoint x="582.0" y="82" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582.0" y="98" as="sourcePoint"/><mxPoint x="582.0" y="104" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582.0" y="120" as="sourcePoint"/><mxPoint x="582.0" y="126" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="built on the filtered DAG: 2,655 subsystems, 3,208 edges, 13 strata, 20.6 M parameters" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=8.3;" vertex="1" parent="1"><mxGeometry x="462" y="162" width="240" height="24" as="geometry"/></mxCell><mxCell id="c59" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent