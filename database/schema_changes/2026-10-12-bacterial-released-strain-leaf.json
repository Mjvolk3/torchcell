  "alternatives_rejected": [
    {
      "alternative": "Resolve each ECK accession to a BW25113 locus tag through the annotation's /gene_synonym layer and store it on BacterialDeletionPerturbation, BacterialMarkedAllelePerturbation and BacterialDegronPerturbation, ledgering what does not resolve (this PR's first draft: 85 rows, 27,540 cells refused)",
      "why_rejected": "The genome gates records: 48 rows whose accession the 2014 annotation lacks, 4 rows of merged pseudogene fragments, 22 rows of duplicated labels and 11 alleles and truncations would be dropped. The owner rejected it: 'the data is the data ... no synonym route, no resolution status'."
    },
    {
      "alternative": "Loosen the locus-tag validator on the existing bacterial leaves (an optional identifier-status field beside a non-tag systematic_gene_name)",
      "why_rejected": "It loosens a required contract on served leaves (schema rule 3) and puts placed and unplaced records in one class."
    },
    {
      "alternative": "Two released-identifier leaves, one under DeletionPerturbation and one under SequencePerturbation",
      "why_rejected": "The axis is a property of the class the label states, and the source states six classes; one leaf with a typed ReleasedStrainKind and its SO pair carries all six without a second copy of the identity contract."
    },
    {
      "alternative": "Add an ECK accession namespace to BacterialGeneNamespace and BACTERIAL_LOCUS_TAG_PATTERNS so the existing leaves accept ECK ids",
      "why_rejected": "gene_namespace names a host's locus-tag space; an ECK accession is a cross-strain catalog id, so this changes the field's meaning, and the alleles and duplicated labels would still have no carrier."
    }
  ],
