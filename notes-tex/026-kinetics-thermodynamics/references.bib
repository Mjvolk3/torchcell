  title = {Small non-coding {RNA} {Interactome} {Capture} reveals pervasive, carbon source-dependent {tRNA} engagement of yeast glycolytic enzymes},
  url = {https://www.biorxiv.org/content/10.1101/2022.07.14.500110v1},
