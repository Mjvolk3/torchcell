  keywords = {torchcell.paper.results6},
  month = {September},
  number = {17},
  pages = {e91},
  shorttitle = {{CRI}-{SPA}},
  title = {{CRI}-{SPA}: a high-throughput method for systematic genetic editing of yeast libraries},
  url = {https://doi.org/10.1093/nar/gkad656},
  urldate = {2026-03-13},
  volume = {51},
  year = {2023}
}

