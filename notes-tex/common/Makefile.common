# notes-tex/common/Makefile.common
# [[notes-tex.common.Makefile]]
# https://github.com/Mjvolk3/torchcell/tree/main/notes-tex/common/Makefile.common
#
# Shared build rules for every document in notes-tex/. A per-document Makefile
# sets DOC (and optionally ZOTERO_COLLECTION) then includes this file:
#
#     DOC := main
#     ZOTERO_COLLECTION := FE8DQKUH
#     include ../common/Makefile.common
#
# Targets
#   make            -> $(DOC).pdf, draft view (status chips + provenance flags)
#   make clean-view -> $(DOC)-clean.pdf, for sharing outside the group
#   make check      -> formatting + provenance + status report (does not build)
#   make bib        -> re-export references.bib from the Zotero group collection
#   make figures    -> re-export any draw.io sources this doc references
#   make plots      -> convert matplotlib SVGs from ASSET_IMAGES_DIR into figures/
#   make watch      -> rebuild on save
#   make clean      -> remove build artifacts
#
# Build engine is Tectonic, same as the manuscript: one binary, no TeX Live
# install, deterministic package fetching.  conda install -c conda-forge tectonic

TECTONIC ?= $(shell command -v tectonic 2>/dev/null || echo /tmp/tectonic)
PYTHON   ?= python
COMMON   := ../common
REPO     := ../..

# Tectonic does not honor TEXINPUTS, so shared style files are symlinked into the
# document directory at build time instead. A symlink rather than a copy so there
# is exactly one tcdoc.sty in the repo and it cannot drift; .gitignore'd, and
# regenerated by any build, so a fresh clone needs no setup step.
SHARED_STY := tcdoc.sty sn-nature.bst

# Zotero, two-tier policy (see notes-tex/README.md):
#   notes-tex documents -> UNION of the GROUP and PERSONAL collections of the
#     same name. Technical notes cite more widely than the manuscript and much of
#     that reading lands in the personal library first.
#   paper/nature-biotech -> GROUP `paper` collection ONLY, via its own
#     zotero_export_bib.py. That is the publication guarantee and is unaffected
#     by anything here.
ZOTERO_GROUP               ?= 6582362
ZOTERO_COLLECTION          ?=
ZOTERO_PERSONAL_COLLECTION ?=

# draw.io headless export, platform-aware (same approach as the manuscript).
DRAWIO_SRC := $(REPO)/notes/assets/drawio
ifeq ($(shell uname -s),Darwin)
  DRAWIO        ?= /Applications/draw.io.app/Contents/MacOS/draw.io
  DRAWIO_EXPORT  = "$(DRAWIO)" -x -f pdf --crop -o
else
  DRAWIO        ?= /tmp/drawio.AppImage
  DRAWIO_EXPORT  = APPIMAGE_EXTRACT_AND_RUN=1 xvfb-run -a $(DRAWIO) --no-sandbox --disable-gpu -x -f pdf --crop -o
endif

SECTIONS := $(wildcard sections/*.tex)
TABLES   := $(wildcard tables/*.tex)
DEPS     := $(DOC).tex $(SECTIONS) $(TABLES) $(COMMON)/tcdoc.sty references.bib

# Reproducible builds. Without this, hyperref writes a wall-clock /CreationDate
# into a compressed object stream, so two builds of IDENTICAL sources differ in
# their bytes and therefore in their sha256. That defeats any attempt to version
# the PDF by content hash -- `zotero_publish.py` could never tell a real revision
# from a re-run of `make`. Tectonic honours SOURCE_DATE_EPOCH (verified: two
# forced rebuilds at a fixed epoch produced the same sha256).
#
# The epoch is the newest mtime among the build inputs, not a constant, so
# \date{\today} still reads as the date the document was last EDITED. That is the
# more honest date for a review copy anyway: rebuilding an untouched document
# tomorrow should not claim tomorrow as its date.
export SOURCE_DATE_EPOCH := $(shell /usr/bin/stat -f %m $(DEPS) 2>/dev/null | sort -n | tail -1)

.PHONY: all clean-view check bib bibcheck figures plots watch clean

all: $(DOC).pdf

tcdoc.sty: $(COMMON)/tcdoc.sty
	@ln -sf $(COMMON)/tcdoc.sty $@
sn-nature.bst: $(REPO)/paper/nature-biotech/sn-nature.bst
	@ln -sf ../../paper/nature-biotech/sn-nature.bst $@

# --keep-logs so `make check` has a .log to read; --synctex for editor jump-to-source.
$(DOC).pdf: $(DEPS) $(SHARED_STY)
	$(TECTONIC) -X compile $(DOC).tex --keep-logs --synctex --outdir .

# The share view. Same body, `clean` option on tcdoc: status chips and src
# pointers disappear, but \external and \secondhand flags deliberately remain --
# an unverified number must never lose its flag just because it left the group.
clean-view: $(DEPS) $(SHARED_STY)
	@sed 's/\\usepackage\[draft\]{tcdoc}/\\usepackage[clean]{tcdoc}/' $(DOC).tex > $(DOC)-clean.tex
	$(TECTONIC) -X compile $(DOC)-clean.tex --keep-logs --outdir .
	@rm -f $(DOC)-clean.tex
	@echo "wrote $(DOC)-clean.pdf"

# The formatting gate. Reads the log from the last build rather than rebuilding,
# so it is fast and can be run in a tight edit loop.
check: $(DOC).pdf
	@$(PYTHON) $(COMMON)/check_doc.py $(DOC)

bib:
ifeq ($(ZOTERO_COLLECTION),)
	@echo "set ZOTERO_COLLECTION in this document's Makefile"; exit 1
else
	@$(PYTHON) $(COMMON)/build_bib.py \
	  --group-id $(ZOTERO_GROUP) \
	  --group-collection $(ZOTERO_COLLECTION) \
	  --personal-collection "$(ZOTERO_PERSONAL_COLLECTION)" \
	  --out references.bib
endif

# CI-able: report citekey conflicts and duplicate works without writing anything.
# Exits non-zero on a key conflict (one key, two works), which is the failure that
# would silently mis-attribute a citation.
bibcheck:
	@$(PYTHON) $(COMMON)/build_bib.py \
	  --group-id $(ZOTERO_GROUP) \
	  --group-collection $(ZOTERO_COLLECTION) \
	  --personal-collection "$(ZOTERO_PERSONAL_COLLECTION)" \
	  --check

# Re-export every draw.io source this document references as figures/NAME.pdf.
figures:
	@for f in $$(grep -rhoE 'figures/[A-Za-z0-9._-]+\.pdf' $(DEPS) 2>/dev/null | sort -u); do \
	  n=$$(basename $$f .pdf); \
	  for ext in drawio.svg drawio.png drawio; do \
	    s="$(DRAWIO_SRC)/$$n.$$ext"; \
	    if [ -f "$$s" ]; then echo "  $$s -> $$f"; $(DRAWIO_EXPORT) "$$f" "$$s" >/dev/null 2>&1; break; fi; \
	  done; \
	done

# Convert every matplotlib panel this document references from the true-size SVG
# the plot script wrote into $ASSET_IMAGES_DIR/$(PLOT_SLUG)/ to figures/NAME.pdf.
#
# Why a target and not a manual step: the plot scripts are the committed source of
# every figure (repo rule), but tectonic cannot include SVG, so something has to
# do the conversion. Left to hand-running rsvg-convert, figures/ silently drifts
# out of date with the scripts -- which is exactly the class of error the rule
# exists to prevent. `make figures` covers draw.io sources; this covers plots.
#
# rsvg-convert, not inkscape: it honours the physical mm dimensions that
# savefig_true_size_svg writes, so a panel drawn 179 mm wide arrives 179 mm wide.
PLOT_SLUG ?= $(notdir $(CURDIR))
PLOT_SRC  := $(REPO)/notes/assets/images/$(PLOT_SLUG)

plots:
	@for f in $$(grep -rhoE 'figures/[A-Za-z0-9._-]+\.pdf' $(DEPS) 2>/dev/null | sort -u); do \
	  n=$$(basename $$f .pdf); \
	  s="$(PLOT_SRC)/$$n.svg"; \
	  if [ -f "$$s" ]; then echo "  $$s -> $$f"; rsvg-convert -f pdf -o "$$f" "$$s"; fi; \
	done

watch:
	$(TECTONIC) -X watch

clean:
	rm -f $(SHARED_STY) $(DOC).pdf $(DOC)-clean.pdf $(DOC).log $(DOC)-clean.log \
	      $(DOC).aux $(DOC).out $(DOC).toc $(DOC).bbl $(DOC).blg $(DOC).synctex.gz
