    "medium_base": {
      "file": "si/genetic.pdftotext.txt",
      "quote": "tryptone 10 g/L, yeast extract 5 g/L, NaCl 50 mM, NH4Cl 9.5 mM, MgCl2 0.528 mM, K2SO4 0.276 mM, FeSO4 0.01 mM, CaCl2 5x10-4 mM, and K2HPO4 1.32 mM;",
