<mxfile><diagram id="families-explainer" name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="705" pageHeight="186" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="11" value="a" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11.1;fontColor=#000000;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.00" y="0.00" width="12.00" height="14.00" as="geometry"/></mxCell><mxCell id="12" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;one gene deletion&lt;/b&gt;&lt;/span&gt;&lt;br&gt;label: essential or not&lt;br&gt;1,121 labeled&lt;br&gt;yeast-GEM genes,&lt;br&gt;195 of them the&lt;br&gt;released held-out set" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="16.00" y="0.00" width="98.00" height="186.00" as="geometry"/></mxCell><mxCell id="13" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;yeast-GEM&lt;/b&gt;&lt;/span&gt;&lt;br&gt;fixed stoichiometry, bounds and gene rules; 4,131 reactions" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="128.00" y="0.00" width="112.00" height="58.00" as="geometry"/></mxCell><mxCell id="14" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;metabolic columns, computed offline&lt;/b&gt;&lt;/span&gt;&lt;br&gt;FBA growth ratios on four media&lt;br&gt;log(1 + |v|) of one parsimonious FBA solve per genotype and medium&lt;br&gt;six gene-protein-reaction rule counts" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="254.00" y="0.00" width="290.00" height="58.00" as="geometry"/></mxCell><mxCell id="15" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;comparators&lt;/b&gt;&lt;/span&gt;&lt;br&gt;on the same 195 genes&lt;br&gt;FBA growth ratio alone 0.640&lt;br&gt;Flux Cone Learning 0.742" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="558.00" y="0.00" width="147.00" height="58.00" as="geometry"/></mxCell><mxCell id="16" value="family 1: the cell graph transformer reading the metabolic solve" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;fontColor=#9D7100;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="128.00" y="58.00" width="300.00" height="14.00" as="geometry"/></mxCell><mxCell id="17" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;gene tokens&lt;/b&gt;&lt;/span&gt;&lt;br&gt;pathway multi-hot and ProtT5" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="128.00" y="72.00" width="112.00" height="50.00" as="geometry"/></mxCell><mxCell id="18" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;cell graph transformer&lt;/b&gt;&lt;/span&gt;&lt;br&gt;attention regularized toward nine gene graphs; the deleted gene's token is pooled" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="254.00" y="72.00" width="160.00" height="50.00" as="geometry"/></mxCell><mxCell id="19" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;logit + affine&lt;/b&gt;&lt;/span&gt;&lt;br&gt;a zero-initialized affine adds the metabolic columns&lt;br&gt;five-fold ensemble 0.934" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="428.00" y="72.00" width="150.00" height="50.00" as="geometry"/></mxCell><mxCell id="20" value="family 2: message passing on the gene graphs" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;fontColor=#863D3A;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="128.00" y="122.00" width="300.00" height="14.00" as="geometry"/></mxCell><mxCell id="21" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;node features&lt;/b&gt;&lt;/span&gt;&lt;br&gt;propagated GO multi-hot, 2,362 columns" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="128.00" y="136.00" width="112.00" height="50.00" as="geometry"/></mxCell><mxCell id="22" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;graph convolution&lt;/b&gt;&lt;/span&gt;&lt;br&gt;two layers over the union of&lt;br&gt;nine gene-gene graphs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="254.00" y="136.00" width="160.00" height="50.00" as="geometry"/></mxCell><mxCell id="23" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;one logit per gene&lt;/b&gt;&lt;/span&gt;&lt;br&gt;five-fold ensemble 0.917" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="428.00" y="136.00" width="150.00" height="50.00" as="geometry"/></mxCell><mxCell id="24" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;average of the two families&lt;/b&gt;&lt;/span&gt;&lt;br&gt;each model's logits standardized, then equal weights, nothing fitted&lt;br&gt;&lt;b&gt;held-out AUROC 0.955&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#6E5479;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=2;spacingLeft=3;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="592.00" y="72.00" width="113.00" height="114.00" as="geometry"/></mxCell><mxCell id="25" value="" style="endArrow=blockThin;endFill=1;endSize=4;html=1;strokeColor=#000000;strokeWidth=0.8;rounded=0;exitX=1;exitY=0.15591397849462366;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="" style="endArrow=blockThin;endFill=1;endSize=4;html=1;strokeColor=#000000;strokeWidth=0.8;rounded=0;exitX=1;exitY=0.521505376344086;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" value="" style="endArrow=blockThin;endFill=1;endSize=4;html=1;strokeColor=#000000;strokeWidth=0.8;rounded=0;exitX=1;exitY=0.8655913978494624;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge=