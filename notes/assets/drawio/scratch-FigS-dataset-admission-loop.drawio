        <mxCell id="bran" value="Admissible when the served datasets' closure fingerprints, the existing graph node classes and the adapter methods they use are all unchanged; new classes, node types and methods pass. Incremental import matches existing node ids and can neither update nor delete them, so any change to a served class takes the full path, and the manifest names the datasets and symbols that force it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.3;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="350" y="254" width="352" height="58" as="geometry" />
