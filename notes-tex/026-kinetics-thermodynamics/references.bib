  shorttitle = {Evo-devo beyond development},
  title = {Evo-devo beyond development: {Generalizing} evo-devo to all levels of the phenotypic evolution},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/bies.202200205},
  urldate = {2024-07-04},
