  "alternatives_rejected": [
    {
      "alternative": "Put growth_phase on CultureEnvironment (the #507 culture-protocol subclass), as first scoped",
      "why_rejected": "BacterialProteinAbundanceExperiment.environment and the other bacterial experiment slots are declared Environment, and pydantic v2 serializes a field by its declared type, so a CultureEnvironment in that slot dumps without growth_phase; narrowing the slots to CultureEnvironment instead refuses every loader that passes a plain Environment (a parent instance in a subclass-typed slot is refused, measured), about 40 bacterial loaders."
    },
    {
      "alternative": "Keep the 'aerobic' default for a blank oxygen cell",
      "why_rejected": "It states a regime the release does not state on 428 samples; a typed gap records exactly what was looked for and where."
    },
    {
      "alternative": "Keep dropping the blank, 'transition', 'aerobic(30% DO)' and stationary samples",
      "why_rejected": "It discards released records to protect a field, which the owner's rule (2026-10-12, the data is the data) forbids."
    },
    {
      "alternative": "Store 'transition' as an aerobicity gap",
      "why_rejected": "The release states a regime; a gap would discard it."
    },
    {
      "alternative": "Add 'aerobic(30% DO)' as its own aerobicity value",
      "why_rejected": "It welds a setpoint into the regime vocabulary, one member per setpoint, and is not queryable by value; the regime and the setpoint are two facts."
    },
    {
      "alternative": "Tell the stationary arms apart by duration_hours alone",
      "why_rejected": "A 24 h duration without a phase reads as a 24 h exponential culture; the release's own description is the phase."
    }
  ],
