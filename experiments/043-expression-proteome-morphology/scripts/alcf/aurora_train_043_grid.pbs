#!/bin/bash -l
#PBS -A GenesisHackathonOct26
#PBS -q capacity
#PBS -l select=1
#PBS -l walltime=168:00:00
#PBS -l filesystems=home:flare
#PBS -r y
#PBS -N 043-aurora-grid
#PBS -j oe
#PBS -o /flare/GenesisHackathonOct26/mjvolk3/torchcell/experiments/043-expression-proteome-morphology/slurm/output/
# experiments/043-expression-proteome-morphology/scripts/alcf/aurora_train_043_grid.pbs
# [[experiments.043-expression-proteome-morphology.scripts.alcf.aurora_train_043_grid]]
# https://github.com/Mjvolk3/torchcell/tree/main/experiments/043-expression-proteome-morphology/scripts/alcf/aurora_train_043_grid.pbs
#
# Round aurora_2026_10_24: one node of the Aurora grid, one cell per tile (all 12 tiles of
# the node, FLAT hierarchy). Rows of aurora_grid_043.tsv whose node column equals NODE run here,
# each on its tile column, through aurora_run_cell_043.sh (stage 1, then the Kemmeren
# fine-tune). -r y plus fixed resume ids: a rerun resumes every stage from its last.pt.
#
#   qsub -v NODE=0 aurora_train_043_grid.pbs
set -uo pipefail
: "${NODE:?qsub -v NODE=<k>}"
HERE=/flare/GenesisHackathonOct26/mjvolk3/torchcell/experiments/043-expression-proteome-morphology/scripts/alcf
# shellcheck disable=SC1091
source "$HERE/aurora_env_043.sh"
export PY TRAIN
export TILES_DIR=/tmp/043_tiles_${PBS_JOBID%%.*}
ulimit -c 0
OUT=$TC_TREE/experiments/043-expression-proteome-morphology/slurm/output/aurora_grid
mkdir -p "$OUT"
echo "job $PBS_JOBID node-slot $NODE on $(hostname) at $(date); tree $SYNCED"

pids=()
while IFS=$'\t' read -r node tile cell finetune overrides; do
  [ "$node" = "$NODE" ] || continue
  # shellcheck disable=SC2086
  ZE_AFFINITY_MASK=$tile bash "$HERE/aurora_run_cell_043.sh" "$cell" "$finetune" $overrides \
    >> "$OUT/$cell.log" 2>&1 &
  pids+=($!)
  echo "tile $tile: $cell (fine-tune $finetune) pid ${pids[-1]}"
done < <(grep -v '^#' "$HERE/aurora_grid_043.tsv")
rc=0
for p in "${pids[@]}"; do wait "$p" || rc=$?; done
echo "done $(date) rc $rc"
exit "$rc"
