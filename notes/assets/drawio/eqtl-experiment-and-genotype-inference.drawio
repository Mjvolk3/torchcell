        <mxCell id="d3" value="&#9679; cis: a variant acting on its OWN gene, usually in the promoter" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="552" y="450" width="140" height="24" as="geometry"/></mxCell>
        <mxCell id="d4" value="&#9679; trans hotspot: one regulatory variant moving hundreds of transcripts" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="552" y="478" width="140" height="34" as="geometry"/></mxCell>
        <mxCell id="d5" value="each cell is one significant (gene, marker) pair: a row of the QTL table" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="552" y="516" width="140" height="24" as="geometry"/></mxCell>
        <mxCell id="pe" value="&lt;b&gt;e&lt;/b&gt;&#160;&#160;What a record stores, as built for the Bloom 2019 segregant panels" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="8" y="562" width="560" height="14" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;b&gt;Stored.&lt;/b&gt;&#10;One record per segregant &#215; condition.&#10;Genotype: SegregantGenotype, a sibling of Genotype. HaplotypeBlocks (chr, start, end, parent, posterior, n_markers) between two pinned SegregantParents.&#10;Variant set: a derived view." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=8.5;align=left;verticalAlign=top;spacingLeft=5;spacingTop=3;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="8" y="584" width="340" height="66" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;b&gt;Not stored, and still open.&lt;/b&gt;&#10;QTL table: an estimate, not a Phenotype.&#10;Intergenic variants: a mosaic needs no gene, a cis-eQTL still has none; per-variant attribution stays open." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.5;align=left;verticalAlign=top;spacingLeft=5;spacingTop=3;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="358" y="584" width="336" height="66" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
