<mxfile host="fba_baseline_compose_figure.py"><diagram id="FigS-yeast9-fba" name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="1" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="a" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=11.1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="18" height="14" as="geometry"/></mxCell><mxCell id="c4" value="Yeast9 and medium" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;verticalAlign=top;strokeColor=#D79B00;fillColor=#FFE6CC;strokeWidth=0.75;fontStyle=1;spacingLeft=3;spacingRight=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="0.0" y="16" width="116" height="126" as="geometry"/></mxCell><mxCell id="c5" value="yeast-GEM 9.0.2: 4,131 reactions, 2,806 metabolites, 1,161 genes. Default medium as distributed: 16 open exchanges, glucose 1 mmol gDW&lt;sup&gt;-1&lt;/sup&gt; h&lt;sup&gt;-1&lt;/sup&gt;, NH&lt;sub&gt;4&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; nitrogen, no amino acids or vitamins." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=8.3;" vertex="1" parent="1"><mxGeometry x="4.0" y="29" width="108" height="111" as="geometry"/></mxCell><mxCell id="c6" value="Gene-reaction rules" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;verticalAlign=top;strokeColor=#D79B00;fillColor=#FFE6CC;strokeWidth=0.75;fontStyle=1;spacingLeft=3;spacingRight=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="130.0" y="16" width="108" height="126" as="geometry"/></mxCell><mxCell id="c7" value="$$s_g = 0 \text{ if } g \in p,\ \text{else } 1$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="134.0" y="29" width="100" height="16" as="geometry"/></mxCell><mxCell id="c8" value="$$v_r = 0 \text{ if } \mathrm{GPR}_r(\mathbf{s}) = \text{false}$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="134.0" y="47" width="100" height="16" as="geometry"/></mxCell><mxCell id="c9" value="A reaction is blocked when its Boolean rule (isozymes OR, complex subunits AND) evaluates false. A gene absent from the model changes nothing." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=8.3;" vertex="1" parent="1"><mxGeometry x="134.0" y="66" width="100" height="74" as="geometry"/></mxCell><mxCell id="c10" value="Deletion sets" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;verticalAlign=top;strokeColor=#D6B656;fillColor=#FFF2CC;strokeWidth=0.75;fontStyle=1;spacingLeft=3;spacingRight=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="252.0" y="16" width="116" height="126" as="geometry"/></mxCell><mxCell id="c11" value="4,036 singles, 651,181 doubles, 332,313 triples: the gene sets of the Kuzmin 2018 triples and their sub-collections. 736 of 4,036 genes are in Yeast9; 7,419 triples have all three genes in the model, 220,392 have none." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=8.3;" vertex="1" parent="1"><mxGeometry x="256.0" y="29" width="108" height="111" as="geometry"/></mxCell><mxCell id="c12" value="FBA growth" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;verticalAlign=top;strokeColor=#6C8EBF;fillColor=#DAE8FC;strokeWidth=0.75;fontStyle=1;spacingLeft=3;spacingRight=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="382.0" y="16" width="100" height="126" as="geometry"/></mxCell><mxCell id="c13" value="$$\mu = \max v_{\mathrm{growth}}$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="386.0" y="29" width="92" height="16" as="geometry"/></mxCell><mxCell id="c14" value="$$\text{s.t. } S v = 0,\ lb \le v \le ub$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="386.0" y="47" width="92" height="16" as="geometry"/></mxCell><mxCell id="c15" value="GLPK, 60 s limit; one LP per deletion set; 128 processes, 10 min in all. &amp;mu;&lt;sub&gt;WT&lt;/sub&gt; = 0.0858 h&lt;sup&gt;-1&lt;/sup&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=8.3;" vertex="1" parent="1"><mxGeometry x="386.0" y="66" width="92" height="74" as="geometry"/></mxCell><mxCell id="c16" value="Fitness proxy" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;verticalAlign=top;strokeColor=#9673A6;fillColor=#E1D5E7;strokeWidth=0.75;fontStyle=1;spacingLeft=3;spacingRight=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="496.0" y="16" width="76" height="126" as="geometry"/></mxCell><mxCell id="c17" value="$$f = \mu / \mu_{\mathrm{WT}}$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="500.0" y="29" width="68" height="16" as="geometry"/></mxCell><mxCell id="c18" value="A non-optimal or timed-out solve counts as f = 0." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=8.3;" vertex="1" parent="1"><mxGeometry x="500.0" y="48" width="68" height="92" as="geometry"/></mxCell><mxCell id="c19" value="Interaction (Fig. 2a)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;verticalAlign=top;strokeColor=#B85450;fillColor=#F8CECC;strokeWidth=0.75;fontStyle=1;spacingLeft=3;spacingRight=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="586.0" y="16" width="121" height="126" as="geometry"/></mxCell><mxCell id="c20" value="$$\varepsilon_{ij} = f_{ij} - f_i f_j$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="590.0" y="29" width="113" height="16" as="geometry"/></mxCell><mxCell id="c21" value="$$\tau_{ijk} = f_{ijk} - f_i f_j f_k$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="590.0" y="45" width="113" height="16" as="geometry"/></mxCell><mxCell id="c22" value="$$\quad - \varepsilon_{ij} f_k - \varepsilon_{ik} f_j - \varepsilon_{jk} f_i$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="590.0" y="59" width="113" height="16" as="geometry"/></mxCell><mxCell id="c23" value="Against the measured &amp;tau; of the same triples: Pearson r = 0.0019 (n = 332,313); 99.93% of predicted |&amp;tau;| &amp;lt; 10&lt;sup&gt;-3&lt;/sup&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=8.3;" vertex="1" parent="1"><mxGeometry x="590.0" y="78" width="113" height="62" as="geometry"/></mxCell><mxCell id="c24" style="endArrow=classic;html=1;strokeWidth=0.75;strokeColor=#666666;endSize=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="117.0" y="79.0" as="sourcePoint"/><mxPoint x="129.0" y="79.0" as="targetPoint"/></mxGeometry