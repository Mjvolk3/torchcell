          <mxGeometry x="600" y="102" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="eD3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="592" y="114" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="aStat2" value="95.5% fill; mean 9.6 nuclei per droplet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="628" y="90" width="70" height="46" as="geometry" />
        </mxCell>

        <mxCell id="aKey" value="In an ordinary droplet run every one of the right-hand droplets is a discarded doublet. Pre-indexing is what converts them into usable cells." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;dashed=1;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="118" y="142" width="580" height="16" as="geometry" />
        </mxCell>

        <!-- ============================= PANEL b ============================= -->
        <mxCell id="pb" value="b" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="176" width="10" height="12" as="geometry" />
        </mxCell>
        <mxCell id="pbh" value="Two rounds, two places: the plate writes round1 into the cell, the droplet ligates round2 on top" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="13" y="176" width="560" height="12" as="geometry" />
        </mxCell>
        <mxCell id="pbNote" value="Round1 is shared by every cell from one well, round2 by every cell in one droplet. Neither alone identifies a cell." style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="198" width="112" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;1. Pre-index in a plate.&lt;/b&gt; Permeabilized cells or nuclei get a well-specific barcoded oligo-dT primer and reverse transcription happens in situ, on one 384-well plate. The primer also carries the UMI and the sequencing primer site." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.5;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="118" y="196" width="176" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ab1" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#666666;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="298" y="227" as="sourcePoint" /><mxPoint x="316" y="227" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Pool and overload.&lt;/b&gt; Cells from every well are mixed and loaded so that most droplets receive several of them. Because the cells already differ by round1, a shared droplet is no longer a collision." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=8.5;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="196" width="176" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ab2" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#666666;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="227" as="sourcePoint" /><mxPoint x="518" y="227" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Ligate round2 in the droplet.&lt;/b&gt; A Chromium gel bead delivers the droplet-specific barcode, joined to the 5&#8242;-phosphate of the RT primer by a thermostable ligase over a bridge oligonucleotide." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=8.5;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="522" y="196" width="176" height="70" as="geometry" />
        </mxCell>

        <mxCell id="idb" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="118" y="272" width="580" height="34" as="geometry" />
        </mxCell>
        <mxCell id="idr1" value="round1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="128" y="280" width="52" height="18" as="geometry" />
        </mxCell>
        <mxCell id="idx" value="&#215;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="182" y="280" width="14" height="18" as="geometry" />
        </mxCell>
        <mxCell id="idr2" value="round2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="198" y="280" width="52" height="18" as="geometry" />
        </mxCell>
        <mxCell id="ideq" value="identifies one cell." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="256" y="280" width="96" height="18" as="geometry" />
        </mxCell>
        <mxCell id="idnote" value="Chromium supplies 737,280 round2 barcodes, so modeling put 1 million resolvable transcriptomes within reach of only 96 round1 wells &#8211; a modeled bound, not a measurement." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="356" y="276" width="336" height="26" as="geometry" />
        </mxCell>

