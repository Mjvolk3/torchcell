# docker/tc-bench/tc-bench.env.example
# Copy to <repo root>/.env.tc-bench (git-ignored) and fill in. No secret goes in this
# file: secrets are separate files under TC_BENCH_SECRETS_DIR.
#
# Create the secrets once (each readable only by the uid:gid in TC_BENCH_UID):
#   umask 077
#   mkdir -p "$TC_BENCH_SECRETS_DIR"
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))" > "$TC_BENCH_SECRETS_DIR/db_password"
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))" > "$TC_BENCH_SECRETS_DIR/jwt_secret"
#   printf '%s\n' '<the SMTP password>' > "$TC_BENCH_SECRETS_DIR/smtp_password"
#   echo '{}' > "$TC_BENCH_SECRETS_DIR/admin_keys.json"   # then add the --gen-admin-key line

# Where the secret files live on the host.
TC_BENCH_SECRETS_DIR=/home/rocky/.config/tc-bench/secrets

# Benchmark bundles (read-only) and submission archives (writable). The defaults are on
# Taiga in the torchcell data tree, beside the tc-data store and the raw mirror
# (data/torchcell/tc-data, data/torchcell/torchcell-raw), so nothing lands on the 40 GB
# root disk. Create both directories before the first `up`.
TC_BENCH_DATASETS_ROOT=/mnt/zhao5/mjvolk3/projects/torchcell/data/torchcell/tc-bench/datasets
TC_BENCH_SUBMISSIONS_ROOT=/mnt/zhao5/mjvolk3/projects/torchcell/data/torchcell/tc-bench/submissions

# uid:gid the API container runs as; it must be able to read the two roots and the secrets.
TC_BENCH_UID=1000:555647

# Host loopback port the API is published on (the reverse proxy forwards to it).
TC_BENCH_PORT=8725

# The public site. ACCOUNT_URL is where the confirmation link points; the token is
# appended as ?verify=<token>. The site uses trailing slashes, so keep the final "/".
TC_BENCH_ACCOUNT_URL=https://example.org/benchmark/account/
TC_BENCH_CORS_ORIGINS=https://example.org

# Outgoing mail (STARTTLS on 587).
TC_BENCH_SMTP_HOST=smtp.example.org
TC_BENCH_SMTP_PORT=587
TC_BENCH_SMTP_USERNAME=tc-bench
TC_BENCH_SMTP_SENDER=noreply@example.org

# 1 holds every new account until an admin approves it.
TC_BENCH_REQUIRE_APPROVAL=0
