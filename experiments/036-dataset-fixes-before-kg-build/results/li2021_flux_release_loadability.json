  "q1_is_it_a_fit": {
    "quote_methods": "Metabolic fluxes were estimated by minimizing the residual sum of squares between experimentally measured and model predicted 13C-enrichment using 13C-Flux software obtained from Dr. Wiechert [33].",
    "quote_the_file_name_the_paper_gives_it": "Additional file 2. MFA simulated result.",
    "quote_tracer": "13C-MFA was performed using 100% 1-13C1 glucose as the feeding substrate was added to a concentration of 10 g/L.",
    "quote_instrument": "The resulting proteinogenic acids were derivatized with N-(tert-butyldimethylsilyl)-N-methyl-trifluoroacetamide containing tert-butyldimethylchlorosilane in acetonitrile at 105 C for 1 h, and then analyzed by a GC-MS [Agilent 7890 A GC and 5975 C Mass Selective Detector (Agilent Technologies, Santa Clara, USA)] equipped with a DB-1column (Agilent Technologies).",
    "quote_correction": "The data obtained from GC-MS were corrected by reduction of the natural abundance ratio of C, H, O, N, and Si isotopes [30].",
    "quote_harvest": "Cells at the exponential growth phase were harvested by centrifugation at 7000 g for 5 min at 4 C.",
    "software": "13CFLUX2, named only through reference [33] (Weitzel 2013); no version, no solver settings, no weighting scheme",
