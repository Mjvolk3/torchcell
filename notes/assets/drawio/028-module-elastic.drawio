<mxfile><diagram id="module-elastic" name="Page-1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="717" pageHeight="221" math="1" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="11" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;gene tokens&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;h&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; from the backbone, perturbed graph" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0.00" y="0.00" width="64.00" height="80.00" as="geometry"/></mxCell><mxCell id="12" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;abundance head&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;&amp;gamma;&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;E&lt;/i&gt;&lt;sup&gt;0&lt;/sup&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; exp(&lt;i&gt;r&lt;/i&gt; tanh(&lt;i&gt;w&lt;/i&gt;&amp;middot;&lt;i&gt;h&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt;)); &lt;i&gt;&amp;gamma;&lt;/i&gt; hard (1 present, 0 deleted), no learned gate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="75.00" y="0.00" width="94.00" height="80.00" as="geometry"/></mxCell><mxCell id="13" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;pool, exact&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; &amp;larr; &lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; min(1, &lt;i&gt;p&lt;/i&gt;&lt;sub&gt;avail&lt;/sub&gt; / &amp;Sigma;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; MW&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt;): the GECKO pool holds" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="180.00" y="0.00" width="74.00" height="80.00" as="geometry"/></mxCell><mxCell id="14" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;unit abundance&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt;: power mean over a complex's subunits, sum over isozymes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="265.00" y="0.00" width="82.00" height="80.00" as="geometry"/></mxCell><mxCell id="15" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;box&lt;/b&gt;&lt;/span&gt;&lt;br&gt;|&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;| &amp;le; &lt;i&gt;k&lt;/i&gt;&lt;sub&gt;cat,&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt;&lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;u&lt;/i&gt;&lt;/sub&gt; &amp;times; scale, inside [&lt;i&gt;lb&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;, &lt;i&gt;ub&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;] scaled by availability" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="358.00" y="0.00" width="92.00" height="80.00" as="geometry"/></mxCell><mxCell id="16" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;elastic growth LP&lt;/b&gt;&lt;/span&gt;&lt;br&gt;max &lt;i&gt;v&lt;/i&gt;&lt;sub&gt;growth&lt;/sub&gt; &amp;minus; &lt;i&gt;M&lt;/i&gt; &amp;Sigma;&lt;i&gt;s&lt;/i&gt; s.t. &lt;i&gt;S&lt;/i&gt;&lt;i&gt;v&lt;/i&gt; = 0, &lt;i&gt;v&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt; &amp;ge; &lt;i&gt;lb&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt; &amp;minus; &lt;i&gt;s&lt;/i&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt; on forced bounds (0 &amp;le; &lt;i&gt;s&lt;/i&gt; &amp;le; &lt;i&gt;lb&lt;/i&gt;), the box otherwise; &lt;i&gt;M&lt;/i&gt; = 1; HiGHS in micromole units" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="461.00" y="0.00" width="122.00" height="80.00" as="geometry"/></mxCell><mxCell id="17" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;optimum&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;v&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt;, &lt;i&gt;z&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="594.00" y="0.00" width="48.00" height="80.00" as="geometry"/></mxCell><mxCell id="18" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;readout&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;a&lt;/i&gt; &lt;i&gt;z&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt; + &lt;i&gt;b&lt;/i&gt;, or gated: head(&lt;i&gt;z&lt;/i&gt;) + &lt;i&gt;g&lt;/i&gt; (&lt;i&gt;a&lt;/i&gt; &lt;i&gt;z&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt; + &lt;i&gt;b&lt;/i&gt;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=0.8;align=center;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="653.00" y="0.00" width="64.00" height="80.00" as="geometry"/></mxCell><mxCell id="19" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="15" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="25" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="17" target="18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="26" value="" style="endArrow=blockThin;endFill=1;endSize=5;html=1;strokeColor=#000000;strokeWidth=0.8;fontFamily=Arial;fontSize=8.3;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="16" target="12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="522.00" y="106.00"/><mxPoint x="122.00" y="106.00"/></Array></mxGeometry></mxCell><mxCell id="27" value="backward: &amp;part;&lt;i&gt;z&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt;/&amp;part;&lt;i&gt;ub&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt; is the dual of the ceiling (envelope theorem), nonzero only where it binds, plus the dual of the elastic row on the ceilings that block maintenance; through &lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt; to the backbone" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=8.3;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="132.00" y="110.00" width="380.00" height="24.00" as="geometry"/></mxCell><mxCell id="28" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;by construction&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;S&lt;/i&gt;&lt;i&gt;v&lt;/i&gt; = 0 and every ceiling hold exactly at &lt;i&gt;v&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt;; the pool holds exactly on &lt;i&gt;E&lt;/i&gt;&lt;sub&gt;&lt;i&gt;g&lt;/i&gt;&lt;/sub&gt;&lt;br&gt;feasible for every genotype by construction: the zero flux with full slack satisfies every row and bound&lt;br&gt;a genotype that cannot meet its maintenance pays &lt;i&gt;M&lt;/i&gt; per unit unmet, so &lt;i&gt;z&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt; goes negative&lt;br&gt;arm flux_projection_anchored_nodiss: no dissipation hinge; Gibbs dissipation is logged only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.8;align=left;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="0.00" y="146.00" width="440.00" height="74.00" as="geometry"/></mxCell><mxCell id="29" value="&lt;span style=&quot;font-size: 9.7px&quot;&gt;&lt;b&gt;measured (round 18 calibration)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;calibration through the layer at initialization: at ceiling scale 1 the maintenance shortfall is 0.54 of 0.70 mmol/gDW/h with zero growth; from scale 10 no slack; a gene-owned bound carries a dual on 97 percent of genotypes at scales 30 to 3,000" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.8;align=left;verticalAlign=middle;spacing=3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="456.00" y="146.00" width="261.00" height="74.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>