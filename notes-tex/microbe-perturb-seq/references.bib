@article{wangSinglecellMassivelyparallelMultiplexed2023,
  title = {Single-Cell Massively-Parallel Multiplexed Microbial Sequencing ({{M3-seq}}) Identifies Rare Bacterial Populations and Profiles Phage Infection},
