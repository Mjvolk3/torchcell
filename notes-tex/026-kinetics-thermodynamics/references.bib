  publisher = {Nature Publishing Group},
  title = {Machine learning reveals genes impacting oxidative stress resistance across yeasts},
  url = {https://www.nature.com/articles/s41467-025-60189-3},
  urldate = {2026-07-09},
  volume = {16},
