arXiv:2212.02374 [cs]},
  pages = {566--576},
  title = {On the {Trade}-off between {Over}-smoothing and {Over}-squashing in {Deep} {Graph} {Neural} {Networks}},
  url = {http://arxiv.org/abs/2212.02374},
  urldate = {2025-02-27},
