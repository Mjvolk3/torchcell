# docker/tc-bench/tc-bench.staging.env.example
# Settings of the staging tier. Copy to <repo root>/.env.tc-bench.staging (git-ignored) and fill
# in. No secret goes in this file: secrets are separate files under
# TC_BENCH_SECRETS_DIR. The two tiers share NOTHING below except the bundles: each has
# its own secrets, archive directory, port and URLs, and compose gives each its own
# database volume.
#
# Create the secrets once (each readable only by the uid:gid in TC_BENCH_UID):
#   umask 077
#   mkdir -p "$TC_BENCH_SECRETS_DIR"
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))" > "$TC_BENCH_SECRETS_DIR/db_password"
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))" > "$TC_BENCH_SECRETS_DIR/jwt_secret"
#   printf '%s\n' '<the CILogon client secret>' > "$TC_BENCH_SECRETS_DIR/cilogon_client_secret"
#   echo '{}' > "$TC_BENCH_SECRETS_DIR/admin_keys.json"   # then add the --gen-admin-key line

# Where the secret files live on the host.
TC_BENCH_SECRETS_DIR=/home/rocky/.config/tc-bench/staging/secrets

# Benchmark bundles (read-only) and submission archives (writable). The defaults are on
# Taiga in the torchcell data tree, beside the tc-data store and the raw mirror
# (data/torchcell/tc-data, data/torchcell/torchcell-raw), so nothing lands on the 40 GB
# root disk. Create both directories before the first `up`.
TC_BENCH_DATASETS_ROOT=/mnt/zhao5/mjvolk3/projects/torchcell/data/torchcell/tc-bench/staging/datasets
TC_BENCH_SUBMISSIONS_ROOT=/mnt/zhao5/mjvolk3/projects/torchcell/data/torchcell/tc-bench/staging/submissions

# uid:gid the API container runs as; it must be able to read the two roots and the secrets.
TC_BENCH_UID=1000:555647

# Host loopback port this tier's API is published on (the reverse proxy forwards to
# it). Staging is 8725 and production is 9725; scripts/tc_bench_deploy.sh checks the
# tier on this port after a deploy.
TC_BENCH_PORT=8725

# The public site. ACCOUNT_URL is where a sign-in ends: the API redirects the browser
# there with a one-time code in the URL fragment. The site uses trailing slashes, so
# keep the final "/".
TC_BENCH_ACCOUNT_URL=https://torchcell-database.ncsa.illinois.edu/staging/benchmark/account/
TC_BENCH_CORS_ORIGINS=https://torchcell-database.ncsa.illinois.edu

# Sign-in is CILogon (https://cilogon.org). Register a client once at
# https://cilogon.org/oauth2/register with
#   callback URL:  <TC_BENCH_PUBLIC_URL>/api/v1/auth/callback   (exact match, HTTPS)
#   scopes:        openid, email, profile, org.cilogon.userinfo
# One CILogon client serves both tiers: register BOTH tiers' callback URLs on it and
# use the same client id and secret in each tier. CILogon approves the registration by
# hand, then issues the client id (below) and the client secret (the
# cilogon_client_secret file, one copy per tier's secrets directory). PUBLIC_URL is the base URL a browser
# uses to reach this API, including any path prefix the reverse proxy adds.
TC_BENCH_PUBLIC_URL=https://torchcell-database.ncsa.illinois.edu/staging
TC_BENCH_CILOGON_CLIENT_ID=cilogon:/client_id/replace-me

# 1 holds every new account until an admin approves it.
TC_BENCH_REQUIRE_APPROVAL=0
