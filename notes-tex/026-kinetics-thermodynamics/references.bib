arXiv:2102.10757 [cs]},
  publisher = {arXiv},
  shorttitle = {Self-{Supervised} {Learning} of {Graph} {Neural} {Networks}},
  title = {Self-{Supervised} {Learning} of {Graph} {Neural} {Networks}: {A} {Unified} {Review}},
  url = {http://arxiv.org/abs/2102.10757},
  urldate = {2023-03-31},
  year = {2022}
}

