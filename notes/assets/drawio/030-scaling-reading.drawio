<mxfile host="app.diagrams.net" agent="claude-code">
  <diagram name="030-scaling-reading" id="030-scaling-reading">
    <mxGraphModel dx="1400" dy="1000" grid="0" page="1" pageWidth="702" pageHeight="320" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c1" value="d" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=11.1;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="14.0" height="14.0" as="geometry"/></mxCell>
<mxCell id="c2" value="Reading the three fits: the question each one answers and what each outcome says to do next" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=9.7;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16.0" y="-1.0" width="600.0" height="14.0" as="geometry"/></mxCell>
<mxCell id="c3" value="Is the loss still falling with D at the full pool, on the matched read?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.0" y="20.0" width="224.7" height="40.0" as="geometry"/></mxCell>
<mxCell id="c4" style="endArrow=classic;html=1;strokeWidth=1.0;strokeColor=#666666;curved=0;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="112.3" y="60.0" as="sourcePoint"/><mxPoint x="112.3" y="72.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="c5" value="yes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.0" y="72.0" width="46.0" height="58.0" as="geometry"/></mxCell>
<mxCell id="c6" value="a new screen beats a larger model: a doubling of distinct records buys 2^-beta of the reducible loss, and beta with its interval is the number to carry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="46.0" y="72.0" width="178.7" height="58.0" as="geometry"/></mxCell>
<mxCell id="c7" style="endArrow=classic;html=1;strokeWidth=1.0;strokeColor=#666666;curved=0;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="112.3" y="130.0" as="sourcePoint"/><mxPoint x="112.3" y="142.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="c8" value="no" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.0" y="142.0" width="46.0" height="58.0" as="geometry"/></mxCell>
<mxCell id="c9" value="data saturates at this size: the curve has met the plateau E + A N^-alpha, and the next unit of effort goes to N or to the floor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="46.0" y="142.0" width="178.7" height="58.0" as="geometry"/></mxCell>
<mxCell id="c10" value="Is the loss still falling with N at the full pool?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="238.7" y="20.0" width="224.7" height="40.0" as="geometry"/></mxCell>
<mxCell id="c11" style="endArrow=classic;html=1;strokeWidth=1.0;strokeColor=#666666;curved=0;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="351.0" y="60.0" as="sourcePoint"/><mxPoint x="351.0" y="72.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="c12" value="yes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="238.7" y="72.0" width="46.0" height="58.0" as="geometry"/></mxCell>
<mxCell id="c13" value="capacity binds: the next size pays, and alpha says how much per doubling; check that lr was right for the top of the ladder first" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="284.7" y="72.0" width="178.7" height="58.0" as="geometry"/></mxCell>
<mxCell id="c14" style="endArrow=classic;html=1;strokeWidth=1.0;strokeColor=#666666;curved=0;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="351.0" y="130.0" as="sourcePoint"/><mxPoint x="351.0" y="142.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="c15" value="no" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="238.7" y="142.0" width="46.0" height="58.0" as="geometry"/></mxCell>
<mxCell id="c16" value="the sizes sit on the plateau E + B D^-beta: more data before more parameters, and the N exponent is descriptive, not a forecast" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="284.7" y="142.0" width="178.7" height="58.0" as="geometry"/></mxCell>
<mxCell id="c17" value="Where does the fitted E sit against the replicate floor of each screen?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="477.3" y="20.0" width="224.7" height="40.0" as="geometry"/></mxCell>
<mxCell id="c18" style="endArrow=classic;html=1;strokeWidth=1.0;strokeColor=#666666;curved=0;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="589.7" y="60.0" as="sourcePoint"/><mxPoint x="589.7" y="72.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="c19" value="below" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="477.3" y="72.0" width="46.0" height="58.0" as="geometry"/></mxCell>
<mxCell id="c20" value="the fit is wrong: no predictor beats the replicate noise, so E and the exponent traded off on too few points" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="523.3" y="72.0" width="178.7" height="58.0" as="geometry"/></mxCell>
<mxCell id="c21" style="endArrow=classic;html=1;strokeWidth=1.0;strokeColor=#666666;curved=0;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="589.7" y="130.0" as="sourcePoint"/><mxPoint x="589.7" y="142.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="c22" value="near" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="477.3" y="142.0" width="46.0" height="58.0" as="geometry"/></mxCell>
<mxCell id="c23" value="the model family is near the noise limit on that screen; the remaining loss is measurement, not modeling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="523.3" y="142.0" width="178.7" height="58.0" as="geometry"/></mxCell>
<mxCell id="c24" style="endArrow=classic;html=1;strokeWidth=1.0;strokeColor=#666666;curved=0;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="589.7" y="200.0" as="sourcePoint"/><mxPoint x="589.7" y="212.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="c25" value="far above" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="477.3" y="212.0" width="46.0" height="58.0" as="geometry"/></mxCell>
<mxCell id="c26" value="the model family is the limit, not the data: a different inductive bias before a bigger grid" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="523.3" y="212.0" width="178.7" height="58.0" as="geometry"/></mxCell>
<mxCell id="c27" value="gate on every fit: the largest point is held out and predicted from the rest. Predicted within the bootstrap interval, the exponent extrapolates one step; missed, it describes the points it was fit on and nothing beyond them. The floored form needs four distinct x in sample for this test." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=0.6;fontFamily=Arial;fontSize=8.3;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="0.0" y="284.0" width="702.0" height="30.0" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
