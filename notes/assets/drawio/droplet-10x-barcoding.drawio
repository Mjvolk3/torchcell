        <mxCell id="l1" value="empty&#10;(most droplets)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="290" y="114" width="92" height="33" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="1 bead + 1 cell:&#10;the usable case" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="394" y="114" width="92" height="33" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="2 cells: a doublet, ~8% at 20,000 recovered" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="486" y="114" width="116" height="33" as="geometry" />
        </mxCell>
        <mxCell id="paRight" value="Loading is Poisson, so occupancy is kept low. You pay per channel of reagent, and cost scales with cells." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="68" width="82" height="66" as="geometry" />
        </mxCell>

        <!-- ============================= PANEL b ============================= -->
        <mxCell id="pb" value="b" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="158" width="10" height="12" as="geometry" />
        </mxCell>
        <mxCell id="pbh" value="Why the zymolyase rides in the RT mix: the wall comes off only after the cell is already isolated" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="13" y="158" width="560" height="12" as="geometry" />
        </mxCell>

        <mxCell id="pbNote" value="1 &#181;L of water in the RT master mix is replaced with 100&#215; zymolyase, so digestion, lysis and RT all happen in one droplet, in that order." style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="178" width="112" height="66" as="geometry" />
        </mxCell>

        <mxCell id="drop" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="118" y="176" width="440" height="44" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="walled cell" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="128" y="186" width="88" height="24" as="geometry" />
        </mxCell>
