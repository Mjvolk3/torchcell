        </mxCell>
        <mxCell id="cplate" value="written in the plate, before the cells ever met a droplet" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="212" y="378" width="344" height="11" as="geometry" />
        </mxCell>
        <mxCell id="cbulk" value="after the emulsion is broken: template switch, amplification, tagmentation with an i7-only transposome" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="452" y="392" width="238" height="22" as="geometry" />
        </mxCell>

        <!-- ============================ BOTTOM NOTE ========================== -->
        <mxCell id="note" value="&lt;b&gt;scifi-RNA-seq is the split-pool trick and the droplet trick composed, and the composition is what removes the Poisson tax.&lt;/b&gt; Split-pool writes a cell's address over successive plate rounds and never isolates anything (Fig. 2); droplet buys one container per cell and pays Poisson for it, keeping occupancy low (Fig. 3). Pre-indexing supplies the first half of the address in a plate, which leaves the droplet responsible only for the second half, so several cells per droplet becomes the operating point rather than the failure. The cost consequence: the per-channel reagent charge that dominates the droplet budget divides across 7.6&#215; more cells, so 137 channels become 18 (Sec. 5.5)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="0" y="420" width="698" height="46" as="geometry" />
        </mxCell>

        <!-- ============================== LEGEND ============================= -->
        <mxCell id="legbox" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="472" width="698" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legt" value="Segments" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
