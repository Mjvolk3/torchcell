    {
      "gate": "G5",
      "outcome": "pass",
      "reason": "EnvironmentResponsePhenotype exists; compounds resolve",
      "evidence": [
        {
          "value": "genotype basis: kanMX deletions introduced into the 3-delta background by SGA",
          "provenance": {
            "source_uri": "paper.md",
            "citation_key": "piotrowskiFunctionalAnnotationChemical2017",
            "sha256": "9314a0dd932c1b20b4dc4297de4ce9452b09f314bf100f05f2fe718fb3415fc1",
            "method": null,
            "page": null,
            "retrieved": null
          },
          "quote": "The MATα query strain was crossed to an ordered array of MATa xxxΔ::kanMX deletion mutants",
          "note": null
        },
        {
          "value": "readout: chemical-genetic z-score, positive = resistant, negative = sensitive (MeasurementType.z_score)",
          "provenance": {
            "source_uri": "si/si1.docx",
            "citation_key": "piotrowskiFunctionalAnnotationChemical2017",
            "sha256": "38cddea8f1a497107304599271bcfcabfba7f65a4f7b3b616f26923be119959a",
            "method": "paragraph text of word/document.xml (the w:t runs of each w:p concatenated); the NIHMS884855 Supplementary Note",
            "page": "Supplementary Note, 'Chemical-genetic interaction scoring method'",
            "retrieved": null
          },
          "quote": "Positive z-scores suggest resistance to the condition, and negative z-scores suggest sensitivity to the condition relative to the fitness of each mutant in the control condition.",
          "note": "the orientation recorded before any pooling: negative is the sick strain, as in Vanacloig 2022, Hoepfner 2014 and Wildenhain 2015 and opposite to both Hillenmeyer 2008 arms"
        }
      ],
      "issue": null,
      "blocked_kind": null
    }
