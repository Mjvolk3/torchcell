# Dockerfile.tc-data
# Slim image for the keyed dataset endpoint (torchcell.datasets.server, "tc-data").
# It serves the artifact store and the raw mirror read-only over HTTP; it is NOT the
# torchcell ML env. The server imports only leaf modules (torchcell.api_keys,
# torchcell.datasets.artifact, torchcell.provenance.build_manifest,
# torchcell.literature.manifest), none of which need torch, PyG, numpy or pyzotero, so
# the image is python:3.13-slim plus the four HTTP/pydantic deps, like Dockerfile.tc-lit.
#
# The two package __init__ files that would drag the ML stack in are blanked after the
# copy: torchcell/datasets/__init__.py eagerly imports every loader (torch, PyG) and
# torchcell/literature/__init__.py imports the Zotero client (pyzotero). The server
# never uses either package's public namespace, only its leaf modules.
#
# Build (context = repo root):  docker build -f Dockerfile.tc-data -t tc-data-endpoint:latest .
# Run is via docker-compose.tc-data.yml (bind-mounts the store, raw mirror and keys, all :ro).

FROM python:3.13-slim

RUN pip install --no-cache-dir \
    "fastapi>=0.115" \
    "uvicorn[standard]>=0.30" \
    "pydantic>=2.8" \
    "python-dotenv>=1.0"

WORKDIR /app
COPY torchcell/ /app/torchcell/
RUN : > /app/torchcell/datasets/__init__.py \
    && : > /app/torchcell/literature/__init__.py

ENV PYTHONPATH=/app \
    TC_DATA_HOST=0.0.0.0 \
    TC_DATA_PORT=8724

EXPOSE 8724

# /health needs no auth; curl is absent from slim, so probe via stdlib urllib.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8724/health').status==200 else 1)"

# Config is 100% env-driven: TC_DATA_ROOT (store mount), TC_DATA_RAW_ROOT (raw mirror
# mount), TC_DATA_KEYS_FILE (keys mount).
CMD ["python", "-m", "torchcell.datasets.server"]
