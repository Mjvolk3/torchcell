# The serving image: the base tc-neo4j image with the torchcell styling seed in its
# Neo4j Browser. Nothing else differs from the base, so the same tag serves the
# generation, build and serving containers of the live rebuild.
#
# Build from the repo's database/ directory (the context), then relaunch the serving
# container with the new tag (the live rebuild's swap does this for a full rebuild):
#
#   python -m torchcell.database.browser_style        # regenerate the seed first
#   docker build -f database/docker/Dockerfile.tc-neo4j-browser \
#       -t michaelvolk/tc-neo4j:5.26.28-browser.1 database
#
# Bump the tag suffix whenever the seed changes; IMAGE in the slurm scripts names the
# tag that serves. The seed is generated by torchcell/database/browser_style.py from the
# schema config and the paper's ontology lane colors; patch_browser_jar.py explains the
# jar edit.
FROM michaelvolk/tc-neo4j:5.26.28

COPY browser/torchcell-seed.js browser/patch_browser_jar.py /tmp/torchcell-browser/
RUN python /tmp/torchcell-browser/patch_browser_jar.py /var/lib/neo4j/lib \
        /tmp/torchcell-browser/torchcell-seed.js \
    && rm -rf /tmp/torchcell-browser
