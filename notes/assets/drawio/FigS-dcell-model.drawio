eColor=#666666;fillColor=#F5F5F5;strokeWidth=0.75;" vertex="1" parent="1"><mxGeometry x="659.0551" y="34" width="13" height="11" as="geometry"/></mxCell><mxCell id="c16" value="$$s_i = 0 \text{ if } g_i \in p, \text{ else } 1$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="484.1102" y="48" width="218.88979999999998" height="14" as="geometry"/></mxCell><mxCell id="c17" value="(term, gene) rows copied per strain; rows of deleted genes zeroed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=8.3;" vertex="1" parent="1"><mxGeometry x="484.1102" y="63" width="218.88979999999998" height="24" as="geometry"/></mxCell><mxCell id="c18" value="Subsystem t, one per GO term" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;verticalAlign=top;strokeColor=#D79B00;fillColor=#FFE6CC;strokeWidth=0.75;fontStyle=1;spacingLeft=3;spacingRight=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="480.1102" y="107.79212" width="226.88979999999998" height="73.79212" as="geometry"/></mxCell><mxCell id="c19" value="$$I_t = \big[\, \Vert_{c \in \mathrm{ch}(t)} O_c \ \big\Vert\ s_{\mathrm{genes}(t)} \big]$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="484.1102" y="120.79212" width="218.88979999999998" height="16" as="geometry"/></mxCell><mxCell id="c20" value="$$O_t = \tanh\big(\mathrm{BN}(W_t I_t + b_t)\big) \in [-1,1]^{L_t}$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="484.1102" y="136.79212" width="218.88979999999998" height="16" as="geometry"/></mxCell><mxCell id="c21" value="$$L_t = \max\big(20,\, \lceil 0.3\,\lvert \mathrm{genes}(t) \rvert \rceil\big)$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="484.1102" y="152.79212" width="218.88979999999998" height="16" as="geometry"/></mxCell><mxCell id="c22" value="Root readout: trigenic interaction" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;verticalAlign=top;strokeColor=#6C8EBF;fillColor=#DAE8FC;strokeWidth=0.75;fontStyle=1;spacingLeft=3;spacingRight=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="480.1102" y="187.58424" width="226.88979999999998" height="41.79212" as="geometry"/></mxCell><mxCell id="c23" value="$$\hat y = w_r^{\top} O_{\mathrm{ROOT}} + b_r$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="484.1102" y="200.58424" width="218.88979999999998" height="16" as="geometry"/></mxCell><mxCell id="c24" value="Auxiliary head on every t &amp;#8800; r" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;verticalAlign=top;strokeColor=#B85450;fillColor=#F8CECC;strokeWidth=0.75;fontStyle=1;spacingLeft=3;spacingRight=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="480.1102" y="235.37635999999998" width="226.88979999999998" height="41.79212" as="geometry"/></mxCell><mxCell id="c25" value="$$\hat y_t = w_t^{\top} O_t + b_t$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="484.1102" y="248.37635999999998" width="218.88979999999998" height="16" as="geometry"/></mxCell><mxCell id="c26" value="Loss" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=8.3;align=left;verticalAlign=top;strokeColor=#666666;fillColor=#F5F5F5;strokeWidth=0.75;fontStyle=1;spacingLeft=3;spacingRight=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="480.1102" y="283.16848" width="226.88979999999998" height="47.79212000000001" as="geometry"/></mxCell><mxCell id="c27" value="$$\mathcal{L} = \mathrm{MSE}(\hat y, y) + \alpha \operatorname*{mean}_{t \neq r} \mathrm{MSE}(\hat y_t, y),\quad \alpha = 0.3$$" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=7;" vertex="1" parent="1"><mxGeometry x="484.1102" y="296.16848" width="218.88979999999998" height="32.79212000000001" as="geometry"/></mxCell><mxCell id="c28" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="0.0" y="353.0" width="227.5591" height="173.2283" as="geometry"/></mxCell><mxCell id="c29" value="b" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=11.1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0.0" y="337.0" width="18" height="14" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="239.6" y="353.0" width="227.5591" height="173.2283" as="geometry"/></mxCell><mxCell id="c31" value="c" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=11.1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="239.6" y="337.0" width="18" height="14" as="geometry"/></mxCell><mxCell id="c32" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="479.1" y="353.0" width="227.559