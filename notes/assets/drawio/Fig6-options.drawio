<mxfile host="app.diagrams.net" type="device"><diagram name="Fig6 panel bank" id="Fig6-panel-bank"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="709" pageHeight="669" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="PANEL BANK. Every panel that exists today, at true print size. Copy into a composition page; do not resize." style="text;html=1;align=left;verticalAlign=top;fontStyle=1;fontSize=9;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.7" y="15.7" width="677.2" height="31.5" as="geometry"/></mxCell><mxCell id="c2" value="bx_ceiling  --  Pigment reliability: betaxanthin 0.914, carotene 0.544" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.7" y="55.1" width="677.2" height="15.7" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="15.7" y="74.8" width="704.7" height="204.7" as="geometry"/></mxCell><mxCell id="c4" value="aa_coupling  --  Amino-acid profile predicts betaxanthin, tyrosine does not" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.7" y="303.1" width="677.2" height="15.7" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="15.7" y="322.8" width="704.7" height="181.1" as="geometry"/></mxCell><mxCell id="c6" value="strand_ceiling  --  Achieved vs ceiling, all strands" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.7" y="527.6" wid