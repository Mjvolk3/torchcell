arXiv:2412.20656 [cs]},
  publisher = {arXiv},
  shorttitle = {Overcoming {Class} {Imbalance}},
  title = {Overcoming {Class} {Imbalance}: {Unified} {GNN} {Learning} with {Structural} and {Semantic} {Connectivity} {Representations}},
