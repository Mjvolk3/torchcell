    "conditions": {
      "file": "si/genetic.pdftotext.txt",
      "quote": "Throughout the fermentation temperature was held at 37o C, dissolved oxygen at 30-50% of saturation, and the pH at 6.95 (via titration with 5% H3PO4).",
