        <mxCell id="b2" value="wall digested&#10;(spheroplast)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="232" y="186" width="88" height="24" as="geometry" />
