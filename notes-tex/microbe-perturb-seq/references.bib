@article{baronasHighthroughputSinglecellOmics2026,
  title = {High-Throughput Single-Cell Omics Using Semipermeable Capsules},
  author = {Baronas, Denis and Norvaisis, Simonas and Zvirblyte, Justina and Leonaviciene, Greta and Mikulenaite, Vincenta and Goda, Karolis and Kaseta, Vytautas and Sablauskas, Karolis and Griskevicius, Laimonas and Juzenas, Simonas and Mazutis, Linas},
