<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram name="droplet-10x-barcoding" id="droplet10xBarcoding">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="703" pageHeight="495" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================================================================
             TRUE-SIZE CANVAS. 100 draw.io units = 1 inch.
             Content 0..702 x 0..490 = 178.2 mm x 124.4 mm
             (caps: 179.4 mm wide, 170 mm tall)
             Arial throughout; 8.5 units = 6.1 pt (Nature 6 pt min), title 12.
             Palette = PLOT_PALETTE / PLOT_PALETTE_FILL slots 1-6, and the
             segment colors MATCH Fig. 2 (splitseq-barcoding.drawio) so the two
             figures can be read against each other:
               orange transcript/cDNA | red cell barcode | blue UMI
               purple gel bead | yellow droplet/oil | gray handle/adapter
             Read layout from experiments/024-perturb-seq-costing/scripts/read_structure.py
             Panel c column grid (c1 and c2 share it):
               handle 200..264 | CB 264..314 | UMI 314..358 | dT 358..394
               cDNA 394..540 | R2 handle 540..604 | i7 604..648
             ================================================================ -->

        <mxCell id="title" value="Droplet barcoding (10x Chromium): cell identity is bought with a container, not built into the sequence" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="702" height="15" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Yeast-adapted 10x Chromium of Jariani 2020 Panels read a to c: the container is made, the wall comes off inside it, and a barcoded molecule comes out. Segment colors and the 5&#8242;-to-3&#8242; convention are those of Fig. 2, so the two methods can be compared directly." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="17" width="702" height="24" as="geometry" />
        </mxCell>

        <!-- ============================= PANEL a ============================= -->
        <mxCell id="pa" value="a" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="48" width="10" height="12" as="geometry" />
        </mxCell>
        <mxCell id="pah" value="Co-encapsulation: one cell plus one barcoded bead in one droplet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="13" y="48" width="500" height="12" as="geometry" />
        </mxCell>

        <mxCell id="paNote" value="Cells enter the chip &lt;b&gt;walled and intact&lt;/b&gt; &#8211; the wall is what lets them survive the journey." style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="0" y="68" width="112" height="48" as="geometry" />
        </mxCell>

        <mxCell id="st1" value="cells (walled) + RT mix" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="118" y="68" width="150" height="13" as="geometry" />
        </mxCell>
