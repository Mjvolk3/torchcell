        </mxCell>
        <mxCell id="pch" value="One bead delivers the whole address at once &#8211; compare Fig. 2, where it arrives in three instalments" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
