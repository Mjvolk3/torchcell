  shorttitle = {{SynLethDB} 2.0},
  title = {{SynLethDB} 2.0: a web-based knowledge graph database on synthetic lethality for novel anticancer drug discovery},
  url = {https://doi.org/10.1093/database/baac030},
  urldate = {2023-09-15},
