        <mxCell id="l3" value="INFERRED mosaic&#10;(HMM posterior)" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
