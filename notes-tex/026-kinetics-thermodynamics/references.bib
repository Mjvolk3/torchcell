@article{motaSharedMoreSpecific2024,
  abstract = {The improvement of yeast tolerance to acetic, butyric, and octanoic acids is an important step for the implementation of economically and technologically sustainable bioprocesses for the bioconversion of renewable biomass resources and wastes. To guide genome engineering of promising yeast cell factories toward highly robust superior strains, it is instrumental to identify molecular targets and understand the mechanisms underlying tolerance to those monocarboxylic fatty acids. A chemogenomic analysis was performed, complemented with physiological studies, to unveil genetic tolerance determinants in the model yeast and cell factory Saccharomyces cerevisiae exposed to equivalent moderate inhibitory concentrations of acetic, butyric, or octanoic acids.},
  author = {Mota, Marta N. and Matos, Madalena and Bahri, Nada and Sá-Correia, Isabel},
