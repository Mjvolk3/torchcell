        <mxCell id="s3bc2" value="BC2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="300" y="317" width="38" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s3bc1" value="BC1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="338" y="317" width="38" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s3dt" value="dT15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="376" y="317" width="38" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s3cdna" value="cDNA (first strand)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Arial;fontSize=8.5;" vertex="1" parent="1">
          <mxGeometry x="414" y="317" width="150" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s3e3" value="3&#8242;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=8.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="566" y="317" width="16" height="22"  as="geometry" />
        </mxCell>
        <mxCell id="s3cellid" value="cell identity = the plate path BC3 &#183; BC2 &#183; BC1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=8.5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="219" y="340" width="200" height="11"  as="geometry" />
        </mxCell>

        <mxCell id="a34" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#666666;endSize=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="131" y="355" as="sourcePoint" />
